#!/usr/bin/env bash
#
# build-rustc -- build rustc against the lean LLVM in ./llvm, so the linker
# keeps only what the compiler actually calls.
#
#   build-rustc zstd       build the one library our binaries link, pinned
#   build-rustc llvm       fetch and prune wasmer's LLVM into ./llvm
#   build-rustc llvm-pack  tar the pruned ./llvm for publishing
#   build-rustc fetch      clone rust at the pinned version
#   build-rustc configure  write bootstrap.toml pointing at ./llvm
#   build-rustc build      ./x build  (RUSTC_STAGE=2 for a self-hosted build)
#   build-rustc strip      strip the compiler binaries (not std)
#   build-rustc trim       drop the llvm-tools nothing calls
#   build-rustc bundle     pull non-system libs into the toolchain, repoint, re-sign
#   build-rustc verify     fail if any binary links outside /usr/lib and /System
#   build-rustc dist       package components + manifest for trustup to install
#   build-rustc dist-merge OUT IN...  one manifest covering both hosts
#   build-rustc upstream-ok  sweep the official dist for what is safe to reuse
#   build-rustc measure    compare the result against the stock toolchain
#
# See NOTES.md for why this should work and what it cannot fix.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LLVM="${TINYRUST_LLVM:-$HERE/llvm}"
SRC="$HERE/rust"

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
die()  { printf 'build-rustc: %s\n' "$*" >&2; exit 1; }

# ---- PLATFORM --------------------------------------------------------------
#
# Two object formats, one script. macOS is Mach-O -- otool, install_name_tool,
# codesign, @loader_path. Linux is ELF -- readelf, patchelf, $ORIGIN. They
# answer the same questions with different tools, so the questions are asked
# here and the rest of the file never names either toolset.
OS="$(uname -s)"

# Is this a file whose link line is worth checking? An archive is never
# loaded, so .a and .rlib are not.
is_object() {
  case "$(file -b "$1" 2>/dev/null)" in
    *Mach-O*|*ELF*) return 0 ;;
    *) return 1 ;;
  esac
}

# The libraries a binary names, one per line, spelled the way its format
# spells them: a path on Mach-O, a soname on ELF.
bin_deps() {
  case "$OS" in
    Darwin) otool -L "$1" 2>/dev/null | tail -n +2 | awk '{print $1}' ;;
    Linux)  readelf -d "$1" 2>/dev/null | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p' ;;
  esac
}

# A library's own name. otool -L prints it first and it is not a dependency;
# ELF calls it the SONAME. Either way it has to come out of the list before
# anything walks it.
bin_id() {
  case "$OS" in
    Darwin) otool -D "$1" 2>/dev/null | tail -n +2 | head -1 ;;
    Linux)  readelf -d "$1" 2>/dev/null | sed -n 's/.*(SONAME).*\[\(.*\)\]/\1/p' ;;
  esac
}

# The directories a relative dependency is looked up in -- LC_RPATH on Mach-O,
# RUNPATH or RPATH on ELF -- with the "beside this file" token already turned
# into a real directory, so the caller can just test whether the file is there.
bin_rpaths() {
  local f="$1" d; d="$(dirname "$f")"
  case "$OS" in
    Darwin) otool -l "$f" 2>/dev/null \
              | awk '/LC_RPATH/{r=1} r && /^ *path /{print $2; r=0}' ;;
    Linux)  readelf -d "$f" 2>/dev/null \
              | sed -n 's/.*R\(UN\)\?PATH.*\[\(.*\)\]/\2/p' | tr ':' '\n' ;;
  esac | sed "s|@loader_path|$d|g; s|@executable_path|$d|g; s|\\\$ORIGIN|$d|g"
}

# Name a library by its own soname, so a binary that links it records the
# name rather than the path it happened to be built at.
bin_setid() {
  case "$OS" in
    Darwin) install_name_tool -id "@rpath/$2" "$1" 2>/dev/null ;;
    Linux)  patchelf --set-soname "$2" "$1" 2>/dev/null ;;
  esac
}

# Point a binary at a copy of a library that travels beside it.
# <file> <old dep> <dir relative to the file> <basename>
bin_point() {
  case "$OS" in
    Darwin) install_name_tool -change "$2" "@loader_path/$3/$4" "$1" 2>/dev/null ;;
    # ELF keeps the soname in NEEDED and finds it through RUNPATH, so the two
    # halves are set separately. --force-rpath writes RPATH, which unlike
    # RUNPATH also applies to what the library itself pulls in.
    Linux)  patchelf --replace-needed "$2" "$4" "$1" 2>/dev/null
            patchelf --force-rpath --set-rpath "\$ORIGIN/$3" "$1" 2>/dev/null ;;
  esac
}

# Editing a Mach-O invalidates its signature, and unsigned Mach-O will not run
# on arm64. ELF has nothing to re-sign.
bin_sign() {
  case "$OS" in Darwin) codesign -f -s - "$1" 2>/dev/null ;; esac
}

# Drop local symbols, keep the exported ones a dylib needs to stay loadable.
# -x is the Mach-O spelling; --strip-unneeded is the ELF one, and it leaves
# .dynsym alone for the same reason.
bin_strip() {
  case "$OS" in
    Darwin) strip -x "$1" ;;
    Linux)  strip --strip-unneeded "$1" ;;
  esac
}

ncpu()   { case "$OS" in Darwin) sysctl -n hw.ncpu ;; Linux) nproc ;; esac; }
fsize()  { case "$OS" in Darwin) stat -f%z "$1" ;; Linux) stat -c%s "$1" ;; esac; }
sha256() { case "$OS" in
             Darwin) shasum -a 256 "$1" | cut -d' ' -f1 ;;
             Linux)  sha256sum "$1" | cut -d' ' -f1 ;;
           esac; }

# What a shipped binary is allowed to depend on.
#
# macOS answers with two directory prefixes, because the OS ships one library
# and everything worth linking lives under it. Linux has no such directory --
# /usr/lib holds whatever the distribution installed there -- so the allowance
# is a list of sonames instead: the C runtime, the compiler runtime, and libz,
# which cargo reaches through libgit2 and which every glibc system has.
# Anything not on this list travels with the toolchain or is a leak.
LINUX_SYSTEM_LIBS="ld-linux-aarch64.so.1 ld-linux-x86-64.so.2 libc.so.6 libm.so.6
                   libdl.so.2 libpthread.so.0 librt.so.1 libgcc_s.so.1 libz.so.1"

dep_is_system() {
  case "$OS" in
    Darwin) case "$1" in /usr/lib/*|/System/*|"") return 0 ;; esac ;;
    Linux)  [ -z "$1" ] && return 0
            case " $(printf '%s' "$LINUX_SYSTEM_LIBS" | tr -s ' \n' '  ') " in
              *" $1 "*) return 0 ;;
            esac ;;
  esac
  return 1
}

# Does this dependency resolve to a file that travels with the toolchain? Not
# whether it is spelled like one -- a dangling @loader_path looks exactly like
# a correctly bundled one until the binary is run.
dep_resolves() { # <file> <dep>
  local f="$1" dep="$2" rp
  case "$dep" in
    @loader_path/*|@executable_path/*)
      [ -e "$(dirname "$f")/${dep#@*path/}" ] && return 0
      return 1 ;;
  esac
  for rp in $(bin_rpaths "$f"); do
    [ -e "$rp/${dep#@rpath/}" ] && return 0
  done
  return 1
}

# Where the library a dependency names actually is, so `bundle` can copy it.
# Mach-O records a path and needs no lookup; ELF records a soname, and only
# the loader knows what that resolves to.
dep_path() { # <file> <dep>
  case "$OS" in
    Darwin) printf '%s' "$2" ;;
    Linux)  ldd "$1" 2>/dev/null \
              | awk -v n="$2" '$1 == n && $2 == "=>" { print $3; exit }' ;;
  esac
}

# The oldest glibc a Linux binary will run against, which is decided by the
# build image and is the Linux half of "does this run on a machine that is not
# this one". Ubuntu 22.04 is the image and 2.35 is its glibc, but nothing on
# the link line reaches past 2.34, so 2.34 is what we hold ourselves to --
# RHEL 9 and Amazon Linux 2023 are worth the check. Raising this is a decision
# about who can install, not a knob to quiet a failure.
GLIBC_MAX="${TINYRUST_GLIBC_MAX:-2.34}"

glibc_needed() {
  objdump -T "$1" 2>/dev/null | grep -o 'GLIBC_[0-9][0-9.]*' \
    | sed 's/GLIBC_//' | sort -uV | tail -1
}
# Every command except dist-merge builds or packages for a host. dist-merge
# only concatenates manifests, and runs on whatever machine assembles the
# release -- Linux in CI -- so the host is checked at dispatch, not at load.
need_host() { [ -n "$HOST" ] || die "cannot build on $(uname -s)/$(uname -m)"; }

# The version the measurements in NOTES.md were taken against, so the
# comparison is like for like. Its LLVM is 22.1.8, which is what ./llvm is.
VERSION="${RUSTC_VERSION:-1.98.0}"
# The machine this compiler will run on. Everything we build except rust-std is
# a native binary for it -- rustc and its driver, cargo, clippy, rustfmt,
# rust-analyzer, miri -- which is the same fact that makes them ours to build
# rather than upstream-ok: linking librustc_driver is being a host binary.
# Taken from the machine, like trustup's host_triple(), so a build on an Intel
# Mac produces an Intel toolchain with no flag to remember. RUSTC_HOST overrides
# it, but only to a host we can actually run the compiler on -- this is not a
# cross-build.
host_triple() {
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64)  echo aarch64-apple-darwin ;;
    Darwin/x86_64) echo x86_64-apple-darwin ;;
    Linux/aarch64) echo aarch64-unknown-linux-gnu ;;
    Linux/x86_64)  echo x86_64-unknown-linux-gnu ;;
    # Empty rather than fatal, so dist-merge still runs here. need_host stops
    # everything else.
    *) echo "" ;;
  esac
}
HOST="${RUSTC_HOST:-$(host_triple)}"
# std is built for each of these, and `dist` packs one rust-std per target.
# The default is the host's own target and nothing else, because that is how
# the official dist is assembled: rust-std is keyed by target, each target's
# artifact is built exactly once by the builder that owns it, and any rustc of
# the same version can load it whatever host it was built on. Two hosts each
# packing both targets would write the same two filenames twice.
#
# Adding the other triple here is still useful locally -- the macOS SDK is
# universal, so x86_64-apple-darwin costs no cross sysroot and gives this tree
# a working cross-compiler. It just should not be published from both hosts.
# A Linux target would need a sysroot and a cross linker.
TARGETS="${RUSTC_TARGETS:-$HOST}"
# stage1 is built by the downloaded stage0 and is enough to measure. stage2 is
# built by stage1 -- the compiler compiling itself -- and is what a real
# distribution ships.
STAGE="${RUSTC_STAGE:-1}"
# LTO mode for compiling rustc itself: thin-local (rust's default, LTO within
# each crate), thin, fat, or off. This changes the compiler, not the binaries
# the compiler produces -- users get LTO from their own -C lto.
# off | thin-local (rust's default) | thin | fat, in increasing order of scope.
# fat measured -5.1 MB on the stripped compiler and ~10% faster type-checking
# but at 2.75x the build time (4:08 -> 11:23), so the default is left alone for
# iteration. Set RUSTC_LTO=fat for a release build.
LTO="${RUSTC_LTO:-}"
# Whether to install the llvm-tools component into the sysroot.
#
# macOS needs exactly one of its 14 binaries: rustc shells out to rust-objcopy
# to honour -Cstrip, so `cargo build --release` with `strip = true` fails
# without it. Linux needs none. link.rs gates that call on is_like_darwin
# (plus solaris and aix) and does the same job with linker flags everywhere
# else, so the whole component is skipped and lib/rustlib/<triple>/bin ships
# empty -- 13.8 MB in the official Linux dist, nothing here.
case "$OS" in Darwin) llvm_tools_default=true ;; *) llvm_tools_default=false ;; esac
LLVM_TOOLS="${RUSTC_LLVM_TOOLS:-$llvm_tools_default}"
# Tools to build alongside the compiler. cargo is the only one that changes
# what the toolchain can do -- without it there is no dependency resolution
# and no build graph, only hand-compiled single files.
# cargo and rustdoc ship in every install: nothing else resolves dependencies,
# and `cargo test` needs rustdoc for doctests.
TOOLS="${RUSTC_TOOLS:-cargo rustdoc}"
# Built and packaged, but not installed by default -- these are components a
# user adds. They have to be built here rather than taken from the official
# dist because each links librustc_driver, so the official build of them is
# tied to the official compiler. See NOTES.md.
TOOLS_OPTIONAL="${RUSTC_TOOLS_OPTIONAL:-clippy rustfmt rust-analyzer miri}"
# What to hand `./x build` for those. Bootstrap's clippy step produces
# cargo-clippy beside clippy-driver, and rustfmt produces cargo-fmt, but
# cargo-miri is a tool of its own (tool.rs: path "src/tools/miri/cargo-miri").
# `cargo miri run` is the only way anyone actually invokes miri, so building
# `miri` alone ships a component that looks installed and has no entry point --
# `cargo miri` answers "no such command". dist already packs both.
tool_targets() {
  local t out=""
  for t in $TOOLS_OPTIONAL; do
    out="$out $t"
    [ "$t" = miri ] && out="$out cargo-miri"
  done
  printf '%s' "$out"
}
# Of the 14 binaries in the llvm-tools component (205 MB), these are kept.
# cargo shells out to rust-objcopy to honour `strip` in release profiles.
# Add llvm-profdata and llvm-cov if you want -C instrument-coverage to be
# usable. llc and opt are 118.7 MB of standalone LLVM developer tools that
# rustc never invokes.
LLVM_TOOLS_KEEP="${RUSTC_LLVM_TOOLS_KEEP:-rust-objcopy}"
# Codegen units for the compiler. Rust's non-incremental default is 16. Fewer
# means better optimisation and slower builds; with fat LTO the units are
# merged anyway, so this mostly affects the pre-LTO stage.
CGU="${RUSTC_CGU:-}"

check_llvm() {
  [ -x "$LLVM/bin/llvm-config" ] || die "no llvm-config in $LLVM -- see NOTES.md"
  note "llvm     $("$LLVM/bin/llvm-config" --version)"
  note "targets  $("$LLVM/bin/llvm-config" --targets-built)$([ -f "$LLVM/bin/llvm-config.real" ] && echo "  (restricted from: $("$LLVM/bin/llvm-config.real" --targets-built))")"
  note "static   $([ -z "$(find "$LLVM/lib" \( -name 'libLLVM*.dylib' -o -name 'libLLVM*.so*' \) 2>/dev/null)" ] && echo yes || echo 'no -- expected archives')"
  # llvm/ is not tracked (it is 604 MB of unpacked tarball), so the wrapper that
  # does the real work lives in the repo and is installed here. Idempotent:
  # llvm-config.real is only created once, from the original binary.
  if ! cmp -s "$HERE/llvm-config-lean" "$LLVM/bin/llvm-config"; then
    [ -f "$LLVM/bin/llvm-config.real" ] || mv "$LLVM/bin/llvm-config" "$LLVM/bin/llvm-config.real"
    install -m 755 "$HERE/llvm-config-lean" "$LLVM/bin/llvm-config"
    note "installed llvm-config wrapper from ./llvm-config-lean"
  fi

  # Bootstrap resolves llvm-ar/-ranlib/-profdata from --bindir, not from the
  # directory llvm-config happens to sit in. The pruned tree keeps them in
  # bin/ while --bindir says usr/bin, so bridge the two.
  local bindir; bindir="$("$LLVM/bin/llvm-config" --bindir)"
  note "bindir   $bindir"
  mkdir -p "$bindir"
  local n=0 f
  for f in "$LLVM"/bin/*; do
    [ -e "$bindir/$(basename "$f")" ] && continue
    ln -sf "$(python3 -c 'import os,sys;print(os.path.relpath(*sys.argv[1:3]))' "$f" "$bindir")" \
      "$bindir/$(basename "$f")"
    n=$((n+1))
  done
  if [ "$n" -gt 0 ]; then note "         linked $n new binaries into it"; fi
}

# ./llvm is wasmer's prebuilt LLVM, pruned. Set up by hand until now, which
# meant CI could not reproduce it. The tarball is 457 MB and unpacks to 2.7 GB;
# we keep about 770 MB of it.
LLVM_RELEASE="${LLVM_RELEASE:-22.x}"
# Two naming conventions meet here, so translate once and keep them apart.
# wasmer names release assets <os>-<arch> with Go and Docker spellings
# (darwin-amd64) -- the convention for "a download for the machine in front of
# you". Rust names things <arch>-<vendor>-<os>, the GNU config.sub order LLVM
# uses for llvm::Triple and rustc inherits -- the convention for "a target to
# compile for", which needs the vendor and ABI fields a two-part name has
# nowhere to put. Neither is wrong; they answer different questions. We publish
# under the rust triple, because our artifacts sit beside rustc-$VERSION-$HOST
# in the same release, and we spell wasmer's name only where we fetch theirs.
case "$HOST" in
  aarch64-apple-darwin)      LLVM_WASMER_ASSET=llvm-darwin-aarch64.tar.xz ;;
  x86_64-apple-darwin)       LLVM_WASMER_ASSET=llvm-darwin-amd64.tar.xz ;;
  aarch64-unknown-linux-gnu) LLVM_WASMER_ASSET=llvm-linux-aarch64.tar.xz ;;
  x86_64-unknown-linux-gnu)  LLVM_WASMER_ASSET=llvm-linux-amd64.tar.xz ;;
  *) LLVM_WASMER_ASSET="" ;;
esac
LLVM_TARBALL="${LLVM_TARBALL:-$LLVM_WASMER_ASSET}"
LLVM_URL="${LLVM_URL:-https://github.com/wasmerio/llvm-custom-builds/releases/download/$LLVM_RELEASE/$LLVM_TARBALL}"

# zstd, built here rather than taken from Homebrew. Two binaries need it and
# neither may depend on a package manager the user does not have:
#
#   librustc_driver   links it, because Compression.cpp.o in libLLVMSupport.a
#                     is pulled in by rustc's LLVMRustLLVMHasZstdCompression.
#                     llvm-config-lean swaps -lzstd for our archive, which
#                     rustc_llvm/build.rs turns into a static link.
#   rust-objcopy      comes out of wasmer's LLVM already linked against their
#                     build machine's libzstd.1.dylib, so `bundle` copies ours
#                     in and repoints it.
#
# 1.5.7 is the version this was developed against -- Homebrew's zstd 1.5.7_1 is
# the same upstream release, so nothing changes by building it. The hash is the
# one facebook/zstd publishes beside the tarball.
ZSTD_VERSION="${ZSTD_VERSION:-1.5.7}"
ZSTD_SHA256="eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3"
ZSTD_URL="${ZSTD_URL:-https://github.com/facebook/zstd/releases/download/v$ZSTD_VERSION/zstd-$ZSTD_VERSION.tar.gz}"
# Per host: an arm64 archive cannot be linked into an x86_64 driver.
ZSTD="${TINYRUST_ZSTD:-$HERE/zstd}"
ZSTD_LIB="$ZSTD/$HOST/lib"
# llvm-config-lean reads this. Exported rather than looked up there, so the
# wrapper needs no idea where this checkout is.
[ -f "$ZSTD_LIB/libzstd.a" ] && export TINYRUST_ZSTD_A="$ZSTD_LIB/libzstd.a"

# Every binary in wasmer's LLVM links their build machine's Homebrew zstd:
#
#   llvm-config.real -> /opt/homebrew/opt/zstd/lib/libzstd.1.dylib
#
# and 15 others the same way. Without that file none of them even start, which
# is why this used to begin with `brew install zstd`. Point them at the zstd we
# built instead -- the same @loader_path trick `bundle` uses on what we ship,
# applied here to the tools we only build with. The path they name is their
# machine's, so match on the library rather than on the path: the Intel build
# names /usr/local, not /opt/homebrew.
llvm_repoint_zstd() {
  # Linux does not need this. wasmer's Linux binaries link the ordinary
  # libzstd.so.1, which the build image installs, and none of them are shipped
  # -- rustc only shells out to an llvm-tool on macOS, so the Linux toolchain
  # carries none of them and there is nothing whose link line we inherit.
  if [ "$OS" != Darwin ]; then
    note "zstd     distro libzstd.so.1, build only -- nothing shipped links it"
    return
  fi
  [ -f "$ZSTD_LIB/libzstd.1.dylib" ] || die "no zstd for $HOST -- run '$0 zstd'"
  mkdir -p "$LLVM/lib"
  cp -f "$ZSTD_LIB/libzstd.1.dylib" "$LLVM/lib/libzstd.1.dylib"
  chmod u+w "$LLVM/lib/libzstd.1.dylib"
  install_name_tool -id "@rpath/libzstd.1.dylib" "$LLVM/lib/libzstd.1.dylib" 2>/dev/null
  codesign -f -s - "$LLVM/lib/libzstd.1.dylib" 2>/dev/null

  local f dep n=0
  for f in "$LLVM"/bin/*; do
    [ -f "$f" ] || continue
    case "$(file -b "$f" 2>/dev/null)" in *Mach-O*) ;; *) continue ;; esac
    while IFS= read -r dep; do
      # Already repointed -- this is idempotent, and the published pruned tree
      # comes back through the fast path with the work already done.
      case "$dep" in @*) continue ;; esac
      [ "$(basename "$dep")" = libzstd.1.dylib ] || continue
      chmod u+w "$f"
      install_name_tool -change "$dep" "@loader_path/../lib/libzstd.1.dylib" "$f" 2>/dev/null
      codesign -f -s - "$f" 2>/dev/null
      n=$((n + 1))
    done < <(otool -L "$f" 2>/dev/null | tail -n +2 | awk '{print $1}')
  done
  note "zstd     ours, $n binaries repointed"
}

# The pruned result, published so a toolchain build does not repeat the 2.7 GB
# unpack. Set TINYRUST_LLVM_URL to one of these and cmd_llvm takes the fast
# path: one download, no pruning.
cmd_llvm_pack() {
  [ -x "$LLVM/bin/llvm-config" ] || die "nothing to pack -- run '$0 llvm'"
  local v; v="$("$LLVM/bin/llvm-config" --version)"
  # Not dist/: `dist` wipes that directory, and this artifact is published on
  # its own schedule -- it changes only when LLVM does.
  local out="$HERE/dist-llvm/tinyrust-llvm-$v-$HOST.tar.xz"
  mkdir -p "$HERE/dist-llvm"
  say "packing $LLVM"
  ( cd "$(dirname "$LLVM")" && tar cf - "$(basename "$LLVM")" ) | xz -9 -T0 > "$out"
  ls -l "$out" | awk '{printf "  %.0f MB  %s\n", $5/1048576, $NF}'
  printf '  sha256 %s\n' "$(sha256 "$out")"
}

cmd_llvm() {
  if [ -x "$LLVM/bin/llvm-config" ] && [ "${1:-}" != "--force" ]; then
    note "$LLVM already set up ($("$LLVM/bin/llvm-config" --version)) -- --force to redo"
    return
  fi
  local work; work="$(mktemp -d)"
  trap 'rm -rf "$work"' RETURN

  # Fast path: an already-pruned tree, 770 MB unpacked instead of 2.7 GB.
  if [ -n "${TINYRUST_LLVM_URL:-}" ]; then
    say "fetching pruned llvm"
    curl -sSfL --retry 3 -o "$work/llvm.tar.xz" "$TINYRUST_LLVM_URL" \
      || die "could not download $TINYRUST_LLVM_URL"
    # The tarball's top-level directory is whatever the packing tree was
    # called, which need not match this one. Unpack aside and move it in.
    mkdir -p "$work/x" && tar -xJf "$work/llvm.tar.xz" -C "$work/x"
    local top; top="$(find "$work/x" -maxdepth 1 -mindepth 1 -type d | head -1)"
    [ -n "$top" ] || die "empty archive at $TINYRUST_LLVM_URL"
    rm -rf "$LLVM"; mkdir -p "$(dirname "$LLVM")"
    mv "$top" "$LLVM"
    # llvm-config-lean is versioned in this repo, so refresh it rather than
    # trusting whatever the artifact was packed with.
    install -m 755 "$HERE/llvm-config-lean" "$LLVM/bin/llvm-config"
    llvm_repoint_zstd
    check_llvm
    return
  fi

  say "fetching $LLVM_TARBALL"
  curl -sSfL --retry 3 -o "$work/llvm.tar.xz" "$LLVM_URL" \
    || die "could not download $LLVM_URL"
  note "$(ls -l "$work/llvm.tar.xz" | awk '{printf "%.0f MB", $5/1048576}')"

  say "unpacking (2.7 GB, most of which is thrown away)"
  mkdir -p "$work/x" && tar -xJf "$work/llvm.tar.xz" -C "$work/x"
  rm -f "$work/llvm.tar.xz"
  # The tarball may or may not have a single top-level directory.
  local root="$work/x"
  [ -d "$root/lib" ] || root="$(find "$work/x" -maxdepth 2 -type d -name lib | head -1 | xargs dirname)"
  [ -d "$root/lib" ] || die "unexpected tarball layout under $work/x"

  say "keeping the archives, the headers and 16 binaries"
  rm -rf "$LLVM"; mkdir -p "$LLVM/bin" "$LLVM/usr"
  cp -R "$root/lib" "$LLVM/lib"
  mkdir -p "$LLVM/usr/include" && cp -R "$root"/usr/include/. "$LLVM/usr/include/" 2>/dev/null \
    || cp -R "$root"/include/. "$LLVM/usr/include/"

  # llvm-config drives the build; the 14 LLVM_TOOLS have to exist in --bindir
  # for bootstrap's llvm-tools step; llvm-ranlib pairs with llvm-ar.
  local b
  for b in llvm-config llvm-ranlib \
           llvm-cov llvm-nm llvm-objcopy llvm-objdump llvm-profdata llvm-readobj \
           llvm-size llvm-strip llvm-ar llvm-as llvm-dis llvm-link llc opt; do
    if [ -f "$root/bin/$b" ]; then cp -L "$root/bin/$b" "$LLVM/bin/$b"
    else note "WARNING: $b missing from the tarball"; fi
  done
  mv "$LLVM/bin/llvm-config" "$LLVM/bin/llvm-config.real"
  install -m 755 "$HERE/llvm-config-lean" "$LLVM/bin/llvm-config"

  llvm_repoint_zstd

  say "done"
  check_llvm
  note "kept $(du -sh "$LLVM" | cut -f1)"
}

# Build zstd for this host. Two things link it (see the ZSTD block above), and
# both used to reach into /opt/homebrew, which is a build-host leak by any
# other name -- `verify` exists because that kept happening. Pinned to one
# version and one hash, so the toolchain is not at the mercy of whatever a
# package manager upgraded to this week.
#
# Built with `clang -arch`, not under Rosetta: clang is universal and this is
# plain C, so an Intel libzstd builds natively on Apple Silicon. That makes
# `RUSTC_HOST=x86_64-apple-darwin $0 zstd` work from an ordinary shell.
cmd_zstd() {
  if [ -f "$ZSTD_LIB/libzstd.a" ] && [ "${1:-}" != "--force" ]; then
    note "zstd already built for $HOST at $ZSTD_LIB -- --force to redo"
    return
  fi
  # macOS clang is universal, so -arch builds either host natively and an Intel
  # libzstd needs no Intel machine. Linux has no equivalent: gcc builds for the
  # machine it is on, and the other host is built by the other runner.
  local cc
  case "$OS/$HOST" in
    Darwin/aarch64-*) cc="clang -arch arm64" ;;
    Darwin/x86_64-*)  cc="clang -arch x86_64" ;;
    Linux/*)          cc="cc" ;;
    *) die "no compiler known for $OS/$HOST" ;;
  esac

  local work; work="$(mktemp -d)"
  trap 'rm -rf "$work"' RETURN

  say "zstd $ZSTD_VERSION for $HOST"
  curl -sSfL --retry 3 -o "$work/zstd.tar.gz" "$ZSTD_URL" \
    || die "could not download $ZSTD_URL"
  local got; got="$(sha256 "$work/zstd.tar.gz")"
  if [ "$ZSTD_VERSION" = 1.5.7 ]; then
    [ "$got" = "$ZSTD_SHA256" ] || die "sha256 mismatch
  expected $ZSTD_SHA256
  got      $got"
    note "sha256   $got"
  else
    # A version bump has to bring its own hash from facebook/zstd's published
    # .sha256 beside the tarball. Refusing is better than checking nothing.
    die "ZSTD_SHA256 is pinned to 1.5.7 -- update it for $ZSTD_VERSION ($got)"
  fi

  tar -xzf "$work/zstd.tar.gz" -C "$work"
  local src="$work/zstd-$ZSTD_VERSION"
  [ -d "$src/lib" ] || die "unexpected tarball layout under $work"

  # CC carries -arch so it reaches both the compile and the link. zstd's
  # Makefile owns CFLAGS, and overriding those would drop its own -O3.
  #
  # The shared library is a macOS need only: it exists so `bundle` can put a
  # copy beside rust-objcopy, and Linux ships no binary out of wasmer's LLVM.
  local targets="libzstd.a"
  [ "$OS" = Darwin ] && targets="libzstd.a libzstd"
  say "building $targets for $HOST"
  make -C "$src/lib" -j "$(ncpu)" CC="$cc" $targets >/dev/null \
    || die "zstd build failed"

  mkdir -p "$ZSTD_LIB"
  cp "$src/lib/libzstd.a" "$ZSTD_LIB/libzstd.a"
  if [ "$OS" = Darwin ]; then
    # The dylib ships under its versioned name and is referenced by the soname
    # libzstd.1.dylib, which is what `bundle` will be looking for.
    local dylib; dylib="$(find "$src/lib" -maxdepth 1 -name 'libzstd.*.dylib' -type f | head -1)"
    [ -n "$dylib" ] || die "no dylib built in $src/lib"
    cp "$dylib" "$ZSTD_LIB/libzstd.1.dylib"
    bin_setid "$ZSTD_LIB/libzstd.1.dylib" libzstd.1.dylib
    bin_sign "$ZSTD_LIB/libzstd.1.dylib"
  fi

  local f
  for f in "$ZSTD_LIB"/libzstd.a "$ZSTD_LIB"/libzstd.1.dylib; do
    [ -f "$f" ] || continue
    printf '  %-22s %6.1f MB  %s\n' "$(basename "$f")" \
      "$(fsize "$f" | awk '{print $1/1048576}')" \
      "$(file -b "$f" | sed 's/,.*//')"
  done
  note "at $ZSTD_LIB"
}

cmd_fetch() {
  say "rust $VERSION"
  if [ -d "$SRC/.git" ]; then
    note "already at $SRC"
  else
    # Shallow, single tag: the full history is ~1 GB and nothing here reads it.
    git clone --depth 1 --branch "$VERSION" \
      https://github.com/rust-lang/rust.git "$SRC"
  fi
  # Bootstrap needs the vendored submodules; LLVM's is the big one and we are
  # supplying our own, so it stays unfetched.
  # library/* are needed to build std at all; src/tools/cargo only for cargo.
  # src/llvm-project stays unfetched -- we supply our own LLVM.
  git -C "$SRC" submodule update --init --depth 1 \
    library/backtrace library/stdarch src/tools/cargo 2>/dev/null || true
  note "at $(git -C "$SRC" describe --tags 2>/dev/null || echo "$VERSION")"
}

cmd_configure() {
  [ -d "$SRC" ] || die "no source -- run '$0 fetch'"
  check_llvm
  local cfg="$SRC/bootstrap.toml"

  cat > "$cfg" <<EOF
# Written by build-rustc. See ../NOTES.md.

# Bootstrap warns without this; we track no bootstrap config changes.
change-id = "ignore"

[llvm]
# The whole point: static archives, so the linker resolves from rustc's 638
# LLVM roots and never pulls ORC, CodeView, PDB or the object readers.
link-shared = false
# Do not fetch rust's own prebuilt LLVM -- we are supplying one.
download-ci-llvm = false$([ "$OS" = Linux ] && cat <<'STDCPP'

# The LLVM archives are C++, so without this librustc_driver needs whatever
# libstdc++.so.6 the build image had -- a GLIBCXX floor on top of the glibc
# one, and a library a minimal image may not carry. Linked statically it
# needs neither, and the driver comes out wanting only libc, libm and
# libgcc_s. It works through an external llvm-config, which is not obvious
# and was measured.
static-libstdcpp = true
STDCPP
)

[build]
target = [$(for t in $TARGETS; do printf '"%s", ' "$t"; done | sed 's/, $//')]
host = ["$HOST"]
# Nothing here needs the docs, and building them is a large part of a full
# bootstrap.
docs = false
extended = false

# cargo pulls OpenSSL in transitively through git2's https feature. Left alone
# it links Homebrew's libssl/libcrypto and the binary will not run on a machine
# without Homebrew -- the same trap as zstd in librustc_driver. The official
# macOS cargo vendors OpenSSL statically (27 symbols, no dylib in otool -L), so
# match it.
[build.tool.cargo]
features = ["vendored-openssl"]

$(for t in $TARGETS; do
cat <<TGT
[target.$t]
llvm-config = "$LLVM/bin/llvm-config"

TGT
done)

[rust]
# LLVM is special and is always built and distributed; this is not a choice.
codegen-backends = ["llvm"]
# Debug info in the compiler itself is worth tens of MB and nothing here reads
# a rustc backtrace.
debug = false${LTO:+$(printf '\nlto = "%s"' "$LTO")}${CGU:+$(printf '\ncodegen-units = %s' "$CGU")}
# These need LLVM's FileCheck, a test-only binary the pruned ./llvm does not
# have. Nothing else in the build wants it.
codegen-tests = false
# The llvm-tools component: 14 binaries bootstrap copies into the sysroot from
# llvm-config --bindir. Each statically links LLVM, so they are large. cargo
# needs exactly one of them (rust-objcopy, to strip release binaries), which is
# why this is now on -- see NOTES.md for which ones earn their place.
llvm-tools = ${LLVM_TOOLS:-true}
EOF
  say "wrote $cfg"
  sed 's/^/  /' "$cfg"
}

cmd_build() {
  [ -f "$SRC/bootstrap.toml" ] || die "not configured -- run '$0 configure'"

  # llvm-config is wrapped (see llvm/bin/llvm-config): it drops libxml2, which
  # nothing on the link line references, and hands back an absolute path to
  # our libzstd.a so zstd is linked statically. Checked rather than hoped for:
  # a bare -lzstd here would link some dylib off the build host and leave the
  # toolchain unable to run anywhere else, which is the exact class of bug
  # `verify` was written for.
  [ -f "$ZSTD_LIB/libzstd.a" ] || die "no zstd for $HOST -- run '$0 zstd'"
  note "system-libs  $("$LLVM/bin/llvm-config" --system-libs --link-static)"

  say "building stage$STAGE"
  # `compiler library` rather than a bare `./x build`: the default step set
  # also builds rustdoc, and `tools = []` does not suppress it. The toolchain
  # we measure against is rustc + rust-std + cargo with no rustdoc, so leaving
  # it unbuilt is what makes the comparison like for like.
  ( cd "$SRC" && ./x build --stage "$STAGE" compiler library $TOOLS $(tool_targets) )
  # Bootstrap leaves tools in stage<N>-tools-bin; only `./x install` moves them
  # into the sysroot. Place them so the tree is a usable toolchain as built.
  local tb="$SRC/build/$HOST/stage$STAGE-tools-bin" t src
  local out_bin="$SRC/build/$HOST/stage$STAGE/bin"
  for t in $TOOLS; do
    # bootstrap calls rustdoc's binary rustdoc_tool_binary in the tools dir.
    case "$t" in rustdoc) src="$tb/rustdoc_tool_binary" ;; *) src="$tb/$t" ;; esac
    local dst="$SRC/build/$HOST/stage$STAGE/bin/$t"
    if [ -f "$src" ]; then
      # bootstrap already hardlinks some tools into the sysroot; installing
      # over itself is an error, so only copy when they really differ.
      if [ "$src" -ef "$dst" ]; then
        note "$t already in the sysroot"
      else
        install -m 755 "$src" "$dst"
        note "installed $t into the sysroot"
      fi
    else
      note "WARNING: $t not found at $src"
    fi
  done

  # Bootstrap hardlinks some optional tools straight into the sysroot. They are
  # components a user adds, not part of a default install, and leaving them
  # there both inflates the install and ships them to people who did not ask.
  # dist packs them from stage<N>-tools-bin, which is untouched by this.
  local opt
  for opt in $TOOLS_OPTIONAL; do
    case "$opt" in
      clippy)        rm -f "$out_bin"/cargo-clippy "$out_bin"/clippy-driver ;;
      rustfmt)       rm -f "$out_bin"/rustfmt "$out_bin"/cargo-fmt ;;
      rust-analyzer) rm -f "$out_bin"/rust-analyzer ;;
      miri)          rm -f "$out_bin"/miri "$out_bin"/cargo-miri ;;
    esac
  done

  say "built"
  note "stage$STAGE at $SRC/build/$HOST/stage$STAGE"
  echo
  cmd_bundle
  echo
  cmd_verify
}

# rust.strip = true would be the supported knob, but it applies -Cstrip=symbols
# to std as well, and stripping an rlib means running rust-objcopy -- part of
# the llvm-tools component we deliberately do not ship. Stripping std would be
# wrong regardless: those archives are linked into user programs and need their
# symbols. So strip the compiler alone, which is where the 34 MB is.
cmd_strip() {
  local out="$SRC/build/$HOST/stage$STAGE"
  [ -d "$out" ] || die "no stage$STAGE -- run '$0 build'"
  local f before after
  # rust-objcopy comes from ./llvm already stripped, so it is not listed.
  # stage<N>-tools-bin is where the optional tools live and where dist packs
  # them from, so they have to be stripped there too.
  for f in "$out"/lib/librustc_driver-*.dylib "$out"/lib/librustc_driver-*.so \
           "$out"/bin/* "$SRC/build/$HOST/stage$STAGE-tools-bin"/*; do
    [ -f "$f" ] || continue
    before=$(fsize "$f")
    # Local symbols go, exported ones stay -- a shared library needs those to
    # remain loadable, on either format.
    bin_strip "$f"
    after=$(fsize "$f")
    awk -v b=$before -v a=$after -v n="$(basename "$f")" \
      'BEGIN{printf "  %-34s %7.1f -> %7.1f MB\n", n, b/1048576, a/1048576}'
  done
  note "rebuild to undo"
}

# The llvm-tools component installs 14 binaries, each statically linking LLVM,
# for 205 MB. Keep only the ones something actually calls.
cmd_trim() {
  local out="$SRC/build/$HOST/stage$STAGE"
  [ -d "$out" ] || die "no stage$STAGE -- run '$0 build'"
  local d f before after kept
  for d in "$out"/lib/rustlib/*/bin; do
    [ -d "$d" ] || continue
    before=$(du -sk "$d" | awk '{print $1}')
    for f in "$d"/*; do
      case " $LLVM_TOOLS_KEEP " in
        *" $(basename "$f") "*) ;;
        *) rm -f "$f" ;;
      esac
    done
    after=$(du -sk "$d" | awk '{print $1}')
    kept=$(ls "$d" 2>/dev/null | tr '\n' ' ')
    awk -v b=$before -v a=$after -v t="$(basename "$(dirname "$d")")" \
      'BEGIN{printf "  %-26s %7.1f -> %5.1f MB\n", t, b/1024, a/1024}'
    note "kept: ${kept:-nothing}"
  done
}

# ---- UPSTREAM-OK -----------------------------------------------------------
#
# A component may be taken from the official dist only if nothing in it is tied
# to the compiler that built it. Two rules decide, and they are the same two
# `trustup`'s upstream_is_independent() applies after unpacking -- one before
# publishing, one at install time, so a wrong list cannot reach a user:
#
#   1. no .rlib and no .rmeta      compiled Rust carries the compiler version
#                                  string in its metadata; mixing gives E0514
#   2. no Mach-O linking           rust-analyzer looks independent and is not:
#      librustc_driver             it links the driver for proc-macro expansion
#
# Change these rules in both files or in neither. trustup:upstream_is_independent
# is the runtime half.
#
# This sweep downloads each candidate from the official dist, unpacks it to a
# temporary directory and applies the rules. It writes ./upstream-ok, which
# `dist` reads. It is slow and rarely needed: run it when adding a component to
# the dist, or when a new Rust release might have changed one.
cmd_upstream_ok() {
  local triple="$HOST"
  local work; work="$(mktemp -d)"
  trap 'rm -rf "$work"' RETURN
  local omf="$work/official.toml"
  say "official manifest"
  curl -sSfL -o "$omf" "https://static.rust-lang.org/dist/channel-rust-stable.toml" \
    || die "could not fetch the official manifest"

  # Everything the official dist publishes, for this target and for "*".
  local cands
  cands="$(grep -o '^\[pkg\.[^.]*\.target\.' "$omf" \
           | sed 's/^\[pkg\.//; s/\.target\.$//' | sort -u)"

  local pkg url tar dir verdict bad keep=""
  for pkg in $cands; do
    url="$(sed -n "/^\[pkg\.$pkg\.target\.$triple\]/,/^\[/p" "$omf" \
           | sed -n 's/^xz_url = "\(.*\)"/\1/p' | head -1)"
    [ -n "$url" ] || url="$(sed -n "/^\[pkg\.$pkg\.target\.\"\*\"\]/,/^\[/p" "$omf" \
           | sed -n 's/^xz_url = "\(.*\)"/\1/p' | head -1)"
    [ -n "$url" ] || continue

    rm -rf "$work/x"; mkdir -p "$work/x"
    tar="$work/c.tar.xz"
    curl -sSfL -o "$tar" "$url" 2>/dev/null || { printf '  %-22s %s\n' "$pkg" "download failed"; continue; }
    tar -xJf "$tar" -C "$work/x" --strip-components=2 2>/dev/null || true
    rm -f "$tar"

    bad=""
    # Rule 1: compiled Rust.
    if find "$work/x" \( -name '*.rlib' -o -name '*.rmeta' \) -print -quit | grep -q .; then
      bad="carries rlib/rmeta"
    else
      # Rule 2: anything linking the driver.
      local f
      while IFS= read -r f; do
        is_object "$f" || continue
        if bin_deps "$f" | grep -q 'librustc_driver'; then
          bad="links librustc_driver ($(basename "$f"))"; break
        fi
      done < <(find "$work/x" -type f)
    fi

    if [ -z "$bad" ]
    then verdict="ok"; keep="$keep$pkg
"
    else verdict="$bad"
    fi
    printf '  %-22s %s\n' "$pkg" "$verdict"
  done

  {
    printf '# Written by `build-rustc upstream-ok`. Do not edit by hand.\n'
    printf '# Official components carrying no .rlib, no .rmeta and no link to\n'
    printf '# librustc_driver -- safe for trustup to fetch upstream.\n'
    printf '%s' "$keep"
  } > "$HERE/upstream-ok"
  say "wrote $(grep -vc '^#' "$HERE/upstream-ok") entries to ./upstream-ok"
}

# Every shipped binary must resolve only against the OS. Anything under
# /opt/homebrew, /usr/local or a build directory is a build-host leak: the
# artifact works here and fails on a machine without that library. This has
# already bitten twice -- zstd in librustc_driver, then OpenSSL in cargo -- so
# it is checked rather than remembered.
#
# Allowed on macOS: /usr/lib and /System (the ABI), and the @rpath/
# @loader_path/@executable_path forms, which resolve inside the toolchain.
# Allowed on Linux: the sonames in LINUX_SYSTEM_LIBS, and anything RUNPATH
# resolves inside the toolchain. Linux gets a second check the other does not
# need -- the glibc a binary was built against is recorded in its symbols, not
# in its dependency list, so a binary that names only allowed libraries can
# still refuse to start on an older machine. See GLIBC_MAX.
# ./llvm's binaries were built against Homebrew's zstd, so anything bootstrap
# copies out of them (rust-objcopy, which rustc *requires* for -Cstrip and
# which cargo triggers via `strip` in release profiles) carries a hard
# dependency on /opt/homebrew. Copy each such library into the toolchain and
# repoint the binary at it with @loader_path, which is the same trick trustup
# uses for libLLVM.dylib. install_name_tool invalidates the code signature, so
# both files are re-signed ad-hoc -- unsigned Mach-O will not run on arm64.
# Package the toolchain the way rust's own dist does, so trustup needs no new
# code path to install it: <pkg>-<version>-<triple>.tar.xz containing
# <pkg>-<version>-<triple>/<component>/<files>, plus a channel manifest giving
# a URL and a SHA-256 per component. Point TRUSTUP_DIST at the output directory
# to install from it.
cmd_dist() {
  local out="$SRC/build/$HOST/stage$STAGE"
  [ -d "$out" ] || die "no stage$STAGE -- run '$0 build'"
  # Published artifacts are always the fat-LTO build: it is worth 15.3 MB
  # across the tools and 5.1 MB on the compiler, and nobody downloading a
  # release cares that it took 13 minutes instead of 5. dist packages what is
  # already built, so refuse rather than quietly ship a thin-local tree.
  grep -q '^lto = "fat"' "$SRC/bootstrap.toml" 2>/dev/null || die \
"this tree was not built with fat LTO, and release artifacts should be.

  RUSTC_LTO=fat $0 configure
  RUSTC_LTO=fat RUSTC_STAGE=$STAGE $0 build
  $0 trim && $0 strip && RUSTC_LTO=fat $0 dist"

  local dist="$HERE/dist" chan="${TINYRUST_CHANNEL:-tinyrust}"
  # Where the packages will be served from. Left as file:// the manifest only
  # works on this machine, which is fine for testing and wrong for a release --
  # CI sets this to the release download URL.
  local base="${TINYRUST_DIST_BASE:-file://$dist}"
  rm -rf "$dist"; mkdir -p "$dist"

  local mf="$dist/channel-rust-$chan.toml"
  printf '# Written by build-rustc dist. Not an official rust manifest.\n' > "$mf"
  printf 'manifest-version = "2"\n' >> "$mf"
  # trustup prints this when installing; the official manifest carries one.
  printf 'date = "%s"\n' "$(date -u +%Y-%m-%d)" >> "$mf"
  printf 'version = "%s"\n' "$VERSION" >> "$mf"

  # Rust encodes the exact compiler version string in crate metadata, so
  # anything that loads an .rmeta or links librustc_driver has to have been
  # built by *this* compiler:
  #
  #   $ our-rustc --sysroot <official toolchain> hello.rs
  #   error[E0514]: found crate `std` compiled by an incompatible version of rustc
  #
  # Which official components trustup may fetch instead of ours. Determined
  # mechanically by `build-rustc upstream-ok`, which downloads each candidate
  # and applies the same two rules trustup applies after unpacking. Do not edit
  # the list by hand: re-run the sweep. See UPSTREAM-OK above.
  local ok
  if [ -f "$HERE/upstream-ok" ]
  then ok="$(grep -v '^#' "$HERE/upstream-ok" | grep -v '^$' \
             | sed 's/.*/"&"/' | paste -sd, - | sed 's/,/, /g')"
  else ok='"cargo", "rust-docs", "rustc-docs", "rust-src", "llvm-tools-preview"'
       note "no upstream-ok file -- using the built-in list; run '$0 upstream-ok'"
  fi
  printf 'upstream-ok = [%s]\n\n' "$ok" >> "$mf"

  pack() { # pack <pkg> <triple> <files...>   (relative to $PACK_FROM)
    local pkg="$1" tri="$2"; shift 2
    local from="${PACK_FROM:-$out}"
    local stem="$pkg-$VERSION-$tri"
    local stage="$dist/.stage/$stem/$pkg"
    rm -rf "$dist/.stage"; mkdir -p "$stage"
    local f
    for f in "$@"; do
      [ -e "$from/$f" ] || continue
      mkdir -p "$stage/$(dirname "$f")"
      cp -R "$from/$f" "$stage/$(dirname "$f")/"
    done
    # Branch filter: relative call targets rewritten to absolute before LZMA.
    # 11.1% off rustc, 8.7% off cargo, nothing to decode. Per component, since
    # rust-std is .rmeta and bitcode rather than machine code and comes out
    # 3.6% bigger filtered. --arm64 needs xz 5.4 to unpack.
    local filter=""
    case "$pkg/$HOST" in
      rust-std/*)  filter="" ;;
      */aarch64-*) filter="--arm64" ;;
      */x86_64-*)  filter="--x86" ;;
    esac
    ( cd "$dist/.stage" && tar cf - "$stem" ) \
      | xz -T0 $filter --lzma2=preset=9 > "$dist/$stem.tar.xz"
    rm -rf "$dist/.stage"
    local hash; hash="$(sha256 "$dist/$stem.tar.xz")"
    cat >> "$mf" <<TOML
[pkg.$pkg.target.$tri]
available = true
xz_url = "$base/$stem.tar.xz"
xz_hash = "$hash"

TOML
    ls -l "$dist/$stem.tar.xz" | awk -v p="$pkg $tri" '{printf "  %-34s %6.1f MB\n", p, $5/1048576}'
  }

  say "packaging stage$STAGE"
  # The compiler, its driver, the bundled libraries it needs, and the
  # per-target binaries (rust-objcopy) that rustc shells out to.
  local rustc_files="bin/rustc bin/rustdoc lib/rustlib/$HOST/bin"
  local d
  for d in "$out"/lib/*.dylib "$out"/lib/*.so "$out"/lib/*.so.*; do
    [ -e "$d" ] && rustc_files="$rustc_files lib/$(basename "$d")"
  done
  pack rustc "$HOST" $rustc_files
  pack cargo "$HOST" bin/cargo

  # The optional tools, each its own component under the name rustup uses, so
  # `trustup component add clippy-preview` finds it where it expects to.
  # Bootstrap leaves these in stage<N>-tools-bin flat; the component tarball
  # has to put them where the sysroot expects, so each is staged by hand.
  local tb="$SRC/build/$HOST/stage$STAGE-tools-bin"
  local comp bins have f
  for comp in $TOOLS_OPTIONAL; do
    case "$comp" in
      clippy)        bins="cargo-clippy clippy-driver"; comp=clippy-preview ;;
      rustfmt)       bins="rustfmt cargo-fmt";          comp=rustfmt-preview ;;
      rust-analyzer) bins="rust-analyzer";              comp=rust-analyzer-preview ;;
      miri)          bins="miri cargo-miri";            comp=miri ;;
      *)             bins="$comp" ;;
    esac
    rm -rf "$dist/.tools"; mkdir -p "$dist/.tools/bin"
    have=""
    for f in $bins; do
      [ -f "$tb/$f" ] && { cp "$tb/$f" "$dist/.tools/bin/$f"; have="$have bin/$f"; }
    done
    # rust-analyzer's proc-macro server lives in libexec, beside the binary.
    if [ "$comp" = rust-analyzer-preview ] && [ -f "$tb/rust-analyzer-proc-macro-srv" ]; then
      mkdir -p "$dist/.tools/libexec"
      cp "$tb/rust-analyzer-proc-macro-srv" "$dist/.tools/libexec/"
      have="$have libexec/rust-analyzer-proc-macro-srv"
    fi
    if [ -n "$have" ]; then
      PACK_FROM="$dist/.tools" pack "$comp" "$HOST" $have
    else
      note "$comp not built -- skipped"
    fi
    rm -rf "$dist/.tools"
  done
  # One rust-std per target, each keyed by its own triple. trustup installs the
  # host's; the others are there for a later `target add` and are not fetched
  # by default.
  local t
  for t in $TARGETS; do
    [ -d "$out/lib/rustlib/$t/lib" ] && pack rust-std "$t" "lib/rustlib/$t/lib"
  done

  echo
  say "install it with"
  note "TRUSTUP_DIST=$dist ./trustup install <dir>"
  note "base $base"
  note "host $HOST -- merge with the other host's dist before publishing"
}

# One channel manifest covers every host and every target, which is how the
# official dist works: a single channel-rust-stable.toml holds 33 hosts' rustc
# entries beside 117 targets' rust-std entries, and rustup picks by its own
# host triple. trustup already does the same, so a release needs one merged
# manifest rather than one per host and an installer that chooses between them.
#
#   build-rustc dist-merge OUT IN...
#
# Package blocks are keyed [pkg.<name>.target.<triple>] and are unioned. A key
# in two inputs is a mistake rather than something to resolve quietly: with
# TARGETS defaulting to the host's own target nothing is built twice, so a
# duplicate means an input was packed with that overridden.
cmd_dist_merge() {
  [ $# -ge 2 ] || die "usage: $0 dist-merge OUT IN [IN...]"
  local out="$1"; shift
  local chan="${TINYRUST_CHANNEL:-tinyrust}" d f
  for d in "$@"; do
    [ -f "$d/channel-rust-$chan.toml" ] || die "no channel-rust-$chan.toml in $d"
  done

  mkdir -p "$out"
  for d in "$@"; do
    for f in "$d"/*.tar.xz; do
      [ -e "$f" ] || continue
      cp -f "$f" "$out/"
    done
  done

  say "merging $# manifests"
  python3 - "$out/channel-rust-$chan.toml" "$chan" "$@" <<'MERGE' || die "merge failed"
import re, sys
out, chan, inputs = sys.argv[1], sys.argv[2], sys.argv[3:]

head, blocks, seen = "", [], {}
for i, d in enumerate(inputs):
    text = open(f"{d}/channel-rust-{chan}.toml", encoding="utf-8").read()
    # Everything before the first [pkg...] is the header -- manifest-version,
    # date, version, upstream-ok. Taken from the first input; the others are
    # the same build of the same release and are expected to agree.
    first = re.search(r"^\[pkg\.", text, re.M)
    top = text[:first.start()] if first else text
    if i == 0:
        head = top
    elif top.strip() != head.strip():
        print(f"  warning: {d} header differs from {inputs[0]}", file=sys.stderr)
    for m in re.finditer(r"^(\[pkg\.[^\]]+\])\n(.*?)(?=^\[pkg\.|\Z)",
                         text, re.M | re.S):
        key, body = m.group(1), m.group(2)
        if key in seen:
            sys.exit(f"  {key} is in both {seen[key]} and {d}")
        seen[key] = d
        blocks.append(key + "\n" + body.rstrip("\n") + "\n\n")

with open(out, "w", encoding="utf-8") as f:
    f.write(head.rstrip("\n") + "\n\n")
    f.writelines(blocks)

for key in sorted(seen):
    print(f"  {key[5:-1]:<44} {seen[key]}")
print(f"  {len(blocks)} packages from {len(inputs)} hosts")
MERGE

  # pipefail would abort on an empty directory, and an empty merge is worth
  # saying out loud rather than crashing over.
  if ls "$out"/*.tar.xz >/dev/null 2>&1; then
    ls -l "$out"/*.tar.xz | awk '{printf "  %6.1f MB  %s\n", $5/1048576, $NF}'
  else
    note "no tarballs in $out"
  fi
  say "wrote $out/channel-rust-$chan.toml"
}

cmd_bundle() {
  local out="$SRC/build/$HOST/stage$STAGE"
  [ -d "$out" ] || die "no stage$STAGE -- run '$0 build'"
  # Bundled libraries go in the prefix's own lib/, not beside whatever binary
  # needed them: lib/rustlib/<triple>/lib belongs to the rust-std component, and
  # a file dropped there would straddle two packages when dist splits them.
  local f dep libdir base src rel n=0
  libdir="$out/lib"

  local id
  while IFS= read -r f; do
    is_object "$f" || continue
    rel="$(python3 -c 'import os,sys;print(os.path.relpath(sys.argv[1], sys.argv[2]))' \
            "$libdir" "$(dirname "$f")")"
    id="$(bin_id "$f")"
    while IFS= read -r dep; do
      [ -n "$id" ] && [ "$dep" = "$id" ] && continue
      # Already fine: the OS carries it, or it resolves inside the toolchain.
      # Resolving is checked rather than the spelling -- the wasmer tools
      # arrive repointed at ./llvm's own libzstd (see llvm_repoint_zstd), and
      # that path does not exist inside a toolchain: rust-objcopy lands in
      # lib/rustlib/<triple>/bin, where ../lib is the rust-std directory. Left
      # alone it fails to load, and `cargo build --release` with `strip = true`
      # cannot run it.
      dep_is_system "$dep" && continue
      dep_resolves "$f" "$dep" && continue
      base="$(basename "$dep")"
      # wasmer's binaries name their own build machine's paths, and rust-objcopy
      # is one of them. Where the library is one we build, take ours: it is the
      # pinned version, it matches the host, and it is there even when that
      # path is not.
      src="$(dep_path "$f" "$dep")"
      [ -f "$ZSTD_LIB/$base" ] && src="$ZSTD_LIB/$base"
      [ -n "$src" ] && [ -f "$src" ] \
        || { note "WARNING: $(basename "$f") wants missing $dep"; continue; }
      mkdir -p "$libdir"
      if [ ! -f "$libdir/$base" ]; then
        cp -L "$src" "$libdir/$base"
        chmod u+w "$libdir/$base"
        bin_setid "$libdir/$base" "$base"
        bin_sign "$libdir/$base"
      fi
      chmod u+w "$f"
      bin_point "$f" "$dep" "$rel" "$base"
      bin_sign "$f"
      note "bundled $base for $(basename "$f")$([ "$src" = "$dep" ] || echo "  (ours, not $(dirname "$src"))")"
      n=$((n + 1))
    done < <(bin_deps "$f")
  done < <(find "$out/bin" "$out/lib" -type f \
            \( -perm -u+x -o -name '*.dylib' -o -name '*.so' -o -name '*.so.*' \) 2>/dev/null)

  if [ "$n" -eq 0 ]; then note "nothing needed bundling"; fi
}

cmd_verify() {
  local out="$SRC/build/$HOST/stage$STAGE"
  [ -d "$out" ] || die "no stage$STAGE -- run '$0 build'"
  local f dep id bad=0 checked=0 need floor=""

  while IFS= read -r f; do
    # Loadable files only; an rlib is an archive and is never linked as one.
    is_object "$f" || continue
    checked=$((checked + 1))
    # A library's own name is not a dependency and nothing has to resolve it,
    # so take it out before walking the list.
    id="$(bin_id "$f")"
    while IFS= read -r dep; do
      [ -n "$id" ] && [ "$dep" = "$id" ] && continue
      dep_is_system "$dep" && continue
      if dep_resolves "$f" "$dep"; then continue; fi
      # Spelled as though it travels with the toolchain, and does not: the
      # failure mode that shipped twice. Anything else is a library off the
      # build host that a user will not have.
      # DANGLING means spelled as though it travels with the toolchain and
      # does not -- the failure that shipped twice. On ELF nothing is spelled
      # that way: a NEEDED entry either resolves through RUNPATH or it is a
      # library off the build host, which is a leak by any name.
      case "$dep" in
        @*) printf '  DANGLING  %-24s -> %s\n' "$(basename "$f")" "$dep" ;;
        *)  printf '  LEAK      %-24s -> %s\n' "$(basename "$f")" "$dep" ;;
      esac
      bad=$((bad + 1))
    done < <(bin_deps "$f")

    # The Linux half of the same question. A binary that resolves every
    # library it names still will not start on a machine whose glibc is older
    # than the one it was built against, and nothing in the dependency list
    # says so -- the version is inside the symbols.
    if [ "$OS" = Linux ]; then
      need="$(glibc_needed "$f")"
      [ -n "$need" ] || continue
      case "$floor" in
        "") floor="$need" ;;
        *)  floor="$(printf '%s\n%s\n' "$floor" "$need" | sort -uV | tail -1)" ;;
      esac
      if [ "$(printf '%s\n%s\n' "$need" "$GLIBC_MAX" | sort -V | tail -1)" != "$GLIBC_MAX" ]; then
        printf '  GLIBC     %-24s -> needs %s, ceiling is %s\n' \
          "$(basename "$f")" "$need" "$GLIBC_MAX"
        bad=$((bad + 1))
      fi
    fi
  done < <(find "$out/bin" "$out/lib" -type f \
            \( -perm -u+x -o -name '*.dylib' -o -name '*.so' -o -name '*.so.*' \) 2>/dev/null)

  if [ "$bad" -gt 0 ]; then
    die "$bad bad dependencie(s) across $checked binaries -- see above"
  fi
  say "every dependency resolves"
  case "$OS" in
    Darwin) note "$checked Mach-O files, each one to /usr/lib, /System or inside the toolchain" ;;
    Linux)  note "$checked ELF files, each one to the C runtime or inside the toolchain"
            note "oldest glibc that will run this: ${floor:-none required}, ceiling $GLIBC_MAX" ;;
  esac
}

cmd_measure() {
  local out="$SRC/build/$HOST/stage$STAGE"
  [ -d "$out" ] || die "no stage$STAGE -- run '$0 build'"
  local stock="$HERE/toolchain/rust-stable"
  # CI builds with no stock toolchain to compare against. Print -- rather than
  # zeroes, and skip every percentage that would divide by one.
  local have_stock=0; [ -d "$stock/lib" ] && have_stock=1

  b() { local t=0 f; for f in "$@"; do [ -f "$f" ] && t=$((t+$(fsize "$f"))); done
        awk -v t=$t 'BEGIN{printf "%.1f", t/1048576}'; }
  k() { du -sk "$@" 2>/dev/null | awk '{t+=$1} END{print t+0}'; }
  # k() of a tree, minus the k() of each path after it.
  minus() { local root=$1; shift; local t; t=$(k "$root"); local p
            for p in "$@"; do [ -e "$p" ] && t=$((t - $(k "$p"))); done
            awk -v t=$t 'BEGIN{printf "%.1f", t/1024}'; }
  pct() { [ "$have_stock" = 1 ] || { printf -- '--'; return; }
          awk -v a=$1 -v b=$2 'BEGIN{ if (a+0 == 0) printf "--"; else printf "%+.0f%%", (b-a)*100/a }'; }
  # stock-side size: -- when there is nothing to measure.
  sb() { [ "$have_stock" = 1 ] && b "$@" || printf -- '--'; }
  sminus() { [ "$have_stock" = 1 ] && minus "$@" || printf -- '--'; }

  say "stage$STAGE"; echo

  local o_drv s_drv s_llvm
  o_drv=$(b "$out"/lib/librustc_driver-*.dylib "$out"/lib/librustc_driver-*.so)
  s_drv=$(sb "$stock"/lib/librustc_driver-*.dylib "$stock"/lib/librustc_driver-*.so)
  # The rustlib copy is a symlink to this one, so it is not counted twice.
  s_llvm=$(sb "$stock"/lib/libLLVM.dylib "$stock"/lib/libLLVM*.so*)

  say "the compiler, and the LLVM inside it"
  printf '  %-30s %8s %11s\n' "" stock "this build"
  printf '  %-30s %8s %11s\n' "librustc_driver" "$s_drv" "$o_drv"
  printf '  %-30s %8s %11s\n' "libLLVM (shared, stock only)" "$s_llvm" "-- static"
  local s_sum; s_sum=$([ "$have_stock" = 1 ] \
    && awk -v a=$s_drv -v b=$s_llvm 'BEGIN{printf "%.1f", a+b}' || printf -- '--')
  printf '  %-30s %8s %11s   %s\n' "" "$s_sum" "$o_drv" "$(pct "$s_sum" "$o_drv")"
  echo

  say "std, per target"
  local t
  for t in $TARGETS; do
    printf '  %-30s %8s %11s\n' "$t" \
      "$([ -d "$stock/lib/rustlib/$t/lib" ] && minus "$stock/lib/rustlib/$t/lib" || echo "--")" \
      "$([ -d "$out/lib/rustlib/$t/lib" ] && minus "$out/lib/rustlib/$t/lib" || echo "--")"
  done
  note "stock ships one target; this build ships $(set -- $TARGETS; echo $#)."
  note "Not an LLVM saving either way: rust.debug = false leaves"
  note "debuginfo-level-std at 0, so these rlibs carry no debug info."
  echo

  # Everything that is not a compiler: the comparison is meaningless without
  # taking these out, since each tree has a different set of them.
  local s_ex="$stock/bin/cargo $stock/bin/rust-analyzer $stock/bin/rust-gdb
              $stock/bin/rust-gdbgui $stock/bin/rust-lldb $stock/libexec
              $stock/share $stock/etc $stock/manifest.in
              $stock/lib/rustlib/$HOST/bin"
  local o_ex="$out/bin/rustdoc"

  say "like for like -- rustc and std only"
  note "out of stock: cargo, rust-analyzer, rust-gdb/gdbgui/lldb, libexec, share, etc"
  note "out of this build: rustdoc$([ -e "$out/bin/rustdoc" ] || echo ' (not built)')"
  echo
  local s_tot o_one o_all
  s_tot=$(sminus "$stock" $s_ex)
  o_all=$(minus "$out" $o_ex)
  # Same capability as stock, i.e. counting only the host target's std.
  o_one=$(minus "$out" $o_ex $(for t in $TARGETS; do
            [ "$t" = "$HOST" ] || echo "$out/lib/rustlib/$t"; done))
  printf '  %-30s %8s\n' "stock (1 std target)" "$s_tot"
  printf '  %-30s %8s   %s\n' "this build (1 std target)" "$o_one" "$(pct "$s_tot" "$o_one")"
  printf '  %-30s %8s   %s\n' "this build (all $(set -- $TARGETS; echo $#) std targets)" "$o_all" "$(pct "$s_tot" "$o_all")"
  echo

  say "backends linked in"
  note "target-list still names $("$out/bin/rustc" --print target-list | wc -l | tr -d ' ') targets -- those specs are unconditional"
  for t in aarch64-apple-darwin x86_64-apple-darwin \
           aarch64-unknown-linux-gnu x86_64-unknown-linux-gnu \
           riscv64gc-unknown-linux-gnu wasm32-unknown-unknown armv7-unknown-linux-gnueabihf; do
    if "$out/bin/rustc" --print target-cpus --target "$t" >/dev/null 2>&1; then
      printf '  %-34s can emit%s\n' "$t" \
        "$([ -d "$out/lib/rustlib/$t/lib" ] && echo '   + std')"
    else
      printf '  %-34s no backend\n' "$t"
    fi
  done
}

case "${1:-}" in
  dist-merge) ;;
  *) need_host ;;
esac

case "${1:-}" in
  zstd)      shift; cmd_zstd "$@" ;;
  llvm)      shift; cmd_llvm "$@" ;;
  llvm-pack) cmd_llvm_pack ;;
  fetch)     cmd_fetch ;;
  configure) cmd_configure ;;
  build)     cmd_build ;;
  strip)     cmd_strip ;;
  trim)      cmd_trim ;;
  bundle)    cmd_bundle ;;
  dist)      cmd_dist ;;
  dist-merge) shift; cmd_dist_merge "$@" ;;
  upstream-ok) cmd_upstream_ok ;;
  verify)    cmd_verify ;;
  measure)   cmd_measure ;;
  *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
esac
