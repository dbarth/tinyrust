#!/usr/bin/env bash
#
# build-rustc -- build rustc against the lean LLVM in ./llvm, so the linker
# keeps only what the compiler actually calls.
#
#   build-rustc fetch      clone rust at the pinned version
#   build-rustc configure  write bootstrap.toml pointing at ./llvm
#   build-rustc build      ./x build  (RUSTC_STAGE=2 for a self-hosted build)
#   build-rustc measure    compare the result against the stock toolchain
#
# See PLAN-rustc.md for why this should work and what it cannot fix.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LLVM="$HERE/llvm"
SRC="$HERE/rust"

# The version the measurements in PLAN-rustc.md were taken against, so the
# comparison is like for like. Its LLVM is 22.1.8, which is what ./llvm is.
VERSION="${RUSTC_VERSION:-1.98.0}"
TRIPLE="aarch64-apple-darwin"
# stage1 is built by the downloaded stage0 and is enough to measure. stage2 is
# built by stage1 -- the compiler compiling itself -- and is what a real
# distribution ships.
STAGE="${RUSTC_STAGE:-1}"

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
die()  { printf 'build-rustc: %s\n' "$*" >&2; exit 1; }

check_llvm() {
  [ -x "$LLVM/bin/llvm-config" ] || die "no llvm-config in $LLVM -- see PLAN-rustc.md"
  note "llvm     $("$LLVM/bin/llvm-config" --version)"
  note "targets  $("$LLVM/bin/llvm-config" --targets-built)$([ -f "$LLVM/bin/llvm-config.real" ] && echo "  (restricted from: $("$LLVM/bin/llvm-config.real" --targets-built))")"
  note "static   $([ -z "$(find "$LLVM/lib" -name 'libLLVM*.dylib' 2>/dev/null)" ] && echo yes || echo 'no -- expected archives')"
  # llvm/ is not tracked (it is 604 MB of unpacked tarball), so the wrapper that
  # does the real work lives in the repo and is installed here. Idempotent:
  # llvm-config.real is only created once, from the original binary.
  if ! cmp -s "$HERE/llvm-config-lean" "$LLVM/bin/llvm-config"; then
    [ -f "$LLVM/bin/llvm-config.real" ] || mv "$LLVM/bin/llvm-config" "$LLVM/bin/llvm-config.real"
    install -m 755 "$HERE/llvm-config-lean" "$LLVM/bin/llvm-config"
    note "installed llvm-config wrapper from ./llvm-config-lean"
  fi

  # Bootstrap resolves llvm-ar/-ranlib/-profdata from --bindir, not from the
  # directory llvm-config happens to sit in. The pruned tree keeps them in
  # bin/ while --bindir says usr/bin, so bridge the two.
  local bindir; bindir="$("$LLVM/bin/llvm-config" --bindir)"
  note "bindir   $bindir"
  if [ ! -e "$bindir/llvm-ar" ]; then
    mkdir -p "$bindir"
    for f in "$LLVM"/bin/*; do
      ln -sf "$(python3 -c 'import os,sys;print(os.path.relpath(*sys.argv[1:3]))' "$f" "$bindir")" \
        "$bindir/$(basename "$f")"
    done
    note "         linked $(ls "$LLVM/bin" | wc -l | tr -d ' ') binaries into it"
  fi
}

cmd_fetch() {
  say "rust $VERSION"
  if [ -d "$SRC/.git" ]; then
    note "already at $SRC"
  else
    # Shallow, single tag: the full history is ~1 GB and nothing here reads it.
    git clone --depth 1 --branch "$VERSION" \
      https://github.com/rust-lang/rust.git "$SRC"
  fi
  # Bootstrap needs the vendored submodules; LLVM's is the big one and we are
  # supplying our own, so it stays unfetched.
  git -C "$SRC" submodule update --init --depth 1 \
    library/backtrace library/stdarch 2>/dev/null || true
  note "at $(git -C "$SRC" describe --tags 2>/dev/null || echo "$VERSION")"
}

cmd_configure() {
  [ -d "$SRC" ] || die "no source -- run '$0 fetch'"
  check_llvm
  local cfg="$SRC/bootstrap.toml"

  cat > "$cfg" <<EOF
# Written by build-rustc. See ../PLAN-rustc.md.

# Bootstrap warns without this; we track no bootstrap config changes.
change-id = "ignore"

[llvm]
# The whole point: static archives, so the linker resolves from rustc's 638
# LLVM roots and never pulls ORC, CodeView, PDB or the object readers.
link-shared = false
# Do not fetch rust's own prebuilt LLVM -- we are supplying one.
download-ci-llvm = false

[build]
target = ["$TRIPLE"]
host = ["$TRIPLE"]
# Nothing here needs the docs, and building them is a large part of a full
# bootstrap.
docs = false
extended = false

[target.$TRIPLE]
llvm-config = "$LLVM/bin/llvm-config"

[rust]
# LLVM is special and is always built and distributed; this is not a choice.
codegen-backends = ["llvm"]
# Debug info in the compiler itself is worth tens of MB and nothing here reads
# a rustc backtrace.
debug = false
# These need LLVM's FileCheck, a test-only binary the pruned ./llvm does not
# have. Nothing else in the build wants it.
codegen-tests = false
# Bootstrap would copy 14 LLVM binaries (llvm-cov, llvm-objdump, opt, llc, ...)
# into the sysroot as the llvm-tools component. Each statically links LLVM --
# they are the 1.7 GB of duplication the pruned ./llvm deleted, and rustc does
# not call them. The 390 MB baseline does not include llvm-tools either, so
# leaving them out keeps the comparison like for like.
llvm-tools = false
EOF
  say "wrote $cfg"
  sed 's/^/  /' "$cfg"
}

cmd_build() {
  [ -f "$SRC/bootstrap.toml" ] || die "not configured -- run '$0 configure'"

  # llvm-config is wrapped (see llvm/bin/llvm-config): it drops libxml2, which
  # nothing on the link line references, and hands back an absolute path to
  # libzstd.a so zstd is linked statically rather than against Homebrew's
  # dylib. No LIBRARY_PATH needed as a result -- if this line still shows a
  # bare -lzstd, no static libzstd was found and the link will pick up the
  # dylib instead, leaving the toolchain tied to Homebrew.
  note "system-libs  $("$LLVM/bin/llvm-config" --system-libs --link-static)"

  say "building stage$STAGE"
  ( cd "$SRC" && ./x build --stage "$STAGE" )
  say "built"
  note "stage$STAGE at $SRC/build/$TRIPLE/stage$STAGE"
}

cmd_measure() {
  local out="$SRC/build/$TRIPLE/stage$STAGE"
  [ -d "$out" ] || die "no stage$STAGE -- run '$0 build'"
  say "stage$STAGE"; echo
  local stock="$HERE/toolchain/rust-stable"

  # Sizes in MB. b() sums files, d() sums a directory.
  b() { local t=0 f; for f in "$@"; do [ -f "$f" ] && t=$((t+$(stat -f%z "$f"))); done
        awk -v t=$t 'BEGIN{printf "%.1f", t/1048576}'; }
  d() { du -sk "$@" 2>/dev/null | awk '{t+=$1} END{printf "%.1f", t/1024}'; }

  local o_drv s_drv s_llvm o_std s_std
  o_drv=$(b "$out"/lib/librustc_driver-*.dylib)
  s_drv=$(b "$stock"/lib/librustc_driver-*.dylib)
  # The copy under rustlib/ is a symlink to this one; count it once.
  s_llvm=$(b "$stock"/lib/libLLVM.dylib)
  o_std=$(d "$out/lib/rustlib/$TRIPLE/lib")
  s_std=$(d "$stock/lib/rustlib/$TRIPLE/lib")

  say "the compiler, and the LLVM inside it"
  printf '  %-26s %8s %9s\n' "" stock "this build"
  printf '  %-26s %8s %9s\n' "librustc_driver" "$s_drv" "$o_drv"
  printf '  %-26s %8s %9s\n' "libLLVM.dylib" "$s_llvm" "-- static"
  printf '  %-26s %8s %9s   %s\n' "" "$(awk -v a=$s_drv -v b=$s_llvm 'BEGIN{printf "%.1f", a+b}')" "$o_drv" \
    "$(awk -v a=$s_drv -v b=$s_llvm -v c=$o_drv 'BEGIN{printf "%+.0f%%", (c-(a+b))*100/(a+b)}')"
  echo
  note "This is the number the exercise is about. The rest is unaffected by"
  note "any LLVM work, exactly as PLAN-rustc.md predicted."
  echo

  say "std"
  printf '  %-26s %8s %9s   %s\n' "rustlib/$TRIPLE/lib" "$s_std" "$o_std" \
    "$(awk -v a=$s_std -v b=$o_std 'BEGIN{printf "%+.0f%%", (b-a)*100/a}')"
  note "Not an LLVM saving: rust.debug = false leaves debuginfo-level-std at 0,"
  note "so these rlibs ship without debug info while the stock ones carry it."
  echo

  say "backends linked in"
  "$out/bin/rustc" --print target-list >/dev/null 2>&1 &&
    note "target-list still names $("$out/bin/rustc" --print target-list | wc -l | tr -d ' ') targets -- those specs are unconditional"
  local t
  for t in aarch64-apple-darwin x86_64-unknown-linux-gnu riscv64gc-unknown-linux-gnu \
           wasm32-unknown-unknown armv7-unknown-linux-gnueabihf; do
    if "$out/bin/rustc" --print target-cpus --target "$t" >/dev/null 2>&1; then
      printf '  %-34s can emit\n' "$t"
    else
      printf '  %-34s no backend\n' "$t"
    fi
  done
  echo

  say "trees"
  printf '  %-26s %8s %9s\n' "total" "$(d "$stock")" "$(d "$out")"
  note "Not like for like: stock adds cargo ($(b "$stock/bin/cargo") MB) and"
  note "rust-analyzer ($(b "$stock/bin/rust-analyzer") MB); this build adds rustdoc ($(b "$out/bin/rustdoc") MB)"
  note "and no cargo. Compare the first table, not this one."
}

case "${1:-}" in
  fetch)     cmd_fetch ;;
  configure) cmd_configure ;;
  build)     cmd_build ;;
  measure)   cmd_measure ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
