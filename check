#!/usr/bin/env bash
#
# check -- a user's first hour with tinyrust, run as a test.
#
#   ./check                 install from ./dist, exercise it
#   ./check --published     install the way the README says, from the release
#   ./check --dist DIR      test a dist directory as built, before it is published
#   ./check --in IMAGE      run the whole thing inside a container image
#   ./check --keep          leave the sandbox behind to poke at
#   ./check -o net          skip anything that needs the network
#   ./check -o heavy        skip `go full`, which downloads 1.4 GB
#   ./check -m doc          run only steps whose name matches
#
# Steps share one sandbox and run in order, so -m is for reading a failure, not
# for running a step on its own: skip the install and the later steps have no
# toolchain to use.
#
# The point is not coverage. It is that a normal "let's try this" session does
# not hit a face plant: install, hello world, release build, docs, a
# dependency, the components we ship, the targets we do not. Each step is one
# `it`, and a step is a user action, not a unit.
#
# Nothing touches the real machine. HOME is a scratch directory, so ~/.rustup,
# ~/.cargo and the shell profile trustup appends to are all inside it.
set -uo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIST="local"; DISTDIR=""; KEEP=0; MATCH=""; OMIT=""; IMAGE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --in)        shift; IMAGE="${1:-}" ;;
    --published) DIST=published ;;
    --local)     DIST=local ;;
    --dist)      shift; DIST=dir; DISTDIR="${1:-}" ;;
    --keep)      KEEP=1 ;;
    -m)          shift; MATCH="${1:-}" ;;
    -o)          shift; OMIT="$OMIT ${1:-}" ;;
    -h|--help)   sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "check: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

# ---- somebody else's machine ----------------------------------------------
#
# The point of --in is that the machine is not yours. A laptop that has built
# this has a compiler, a linker, Xcode, half a toolchain -- and the one thing
# the published tarball has to survive is a machine with none of that.
#
# curl and xz are the installer's own prerequisites and are fetched here when
# the image lacks them, because testing that a container cannot download is
# not testing tinyrust. A compiler is never installed: whether one is present
# is exactly what the `cc` steps below are about.
if [ -n "$IMAGE" ]; then
  args=""
  [ "$KEEP" = 1 ] && args="$args --keep"
  [ -n "$MATCH" ] && args="$args -m $MATCH"
  for o in $OMIT; do args="$args -o $o"; done
  case "$DIST" in
    published) args="$args --published" ;;
    dir)  args="$args --dist /tinyrust/$(basename "$DISTDIR")" ;;
    # --local means $SRC/dist, which is copied in under the same name.
    local) ;;
  esac
  # Only what the check needs. A working copy of this repo also holds rust/,
  # llvm/ and the release directories -- several GB that would be copied into
  # the container before a single step ran.
  case "$DIST" in
    dir)   distsrc="$DISTDIR" ;;
    local) distsrc="$SRC/dist" ;;
    *)     distsrc="" ;;
  esac
  stage="$(mktemp -d "${TMPDIR:-/tmp}/tinyrust-in.XXXXXX")"
  cp "$SRC/check" "$SRC/trustup" "$SRC/install.sh" "$stage/"
  [ -n "$distsrc" ] && [ -d "$distsrc" ] && cp -r "$distsrc" "$stage/$(basename "$distsrc")"
  trap 'rm -rf "$stage"' EXIT
  printf '\033[1m%s\033[0m\n' "check in $IMAGE"
  exec docker run --rm -v "$stage:/src:ro" "$IMAGE" sh -c '
    set -e
    # Only what is actually missing. Rocky 9 ships curl-minimal, which
    # provides the curl command and conflicts with the curl package, so
    # asking for both is an error rather than a no-op.
    have_curl=1; have_xz=1
    command -v curl >/dev/null 2>&1 || have_curl=0
    command -v xz   >/dev/null 2>&1 || have_xz=0
    if [ "$have_curl" = 0 ] || [ "$have_xz" = 0 ]; then
      if command -v apt-get >/dev/null 2>&1; then
        pkgs="ca-certificates"
        [ "$have_curl" = 0 ] && pkgs="$pkgs curl"
        [ "$have_xz" = 0 ] && pkgs="$pkgs xz-utils"
        apt-get update -qq >/dev/null
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
          $pkgs >/dev/null
      else
        pkgs=""
        [ "$have_curl" = 0 ] && pkgs="$pkgs curl"
        [ "$have_xz" = 0 ] && pkgs="$pkgs xz"
        if command -v microdnf >/dev/null 2>&1; then microdnf -y install $pkgs >/dev/null
        elif command -v dnf >/dev/null 2>&1; then dnf -y install $pkgs >/dev/null
        elif command -v apk >/dev/null 2>&1; then apk add --quiet $pkgs
        else echo "check: missing$pkgs and no package manager I know" >&2; exit 2
        fi
      fi
    fi
    command -v bash >/dev/null 2>&1 || { echo "check: this image has no bash" >&2; exit 2; }
    cp -r /src /tinyrust && cd /tinyrust && exec bash ./check '"$args"'
  '
fi

# ---- the harness ----------------------------------------------------------

PASS=0; FAIL=0; SKIP=0; FAILED=""
TICK=$(printf '\342\234\223'); CROSS=$(printf '\342\234\227')
g() { printf '\033[32m%s\033[0m' "$*"; }
r() { printf '\033[31m%s\033[0m' "$*"; }
d() { printf '\033[2m%s\033[0m' "$*"; }
say() { printf '\n\033[1m%s\033[0m\n' "$*"; }

# it <name> <tag,...> <body>
#
# The body runs with `set -e` in a subshell, so the first command that fails
# fails the step. Output is captured and shown only when it does -- a passing
# step should say nothing but its name.
it() {
  local name="$1" tags="$2" body="$3" t0 t1 rc log
  if [ -n "$MATCH" ] && [[ "$name" != *"$MATCH"* ]]; then return; fi
  local tag
  for tag in ${tags//,/ }; do
    case " $OMIT " in *" $tag "*)
      printf '  %s %s %s\n' "$(d '-')" "$name" "$(d "(skipped: $tag)")"
      SKIP=$((SKIP + 1)); return ;;
    esac
  done
  log="$WORK/log/$(printf '%03d' $((PASS + FAIL + 1))).log"
  t0=$SECONDS
  ( set -e; cd "$WORK"; eval "$body" ) > "$log" 2>&1
  rc=$?
  t1=$((SECONDS - t0))
  if [ $rc -eq 0 ]; then
    PASS=$((PASS + 1))
    printf '  %s %s %s\n' "$(g "$TICK")" "$name" "$(d "${t1}s")"
  else
    FAIL=$((FAIL + 1)); FAILED="$FAILED  $name\n"
    printf '  %s %s %s\n' "$(r "$CROSS")" "$name" "$(r "exit $rc")"
    sed 's/^/      /' "$log" | tail -20
  fi
}

# Assertions, named so a failing step reads like a sentence in the log.
contains() { # contains <file> <pattern>
  grep -qE -- "$2" "$1" || { echo "expected /$2/ in:"; cat "$1"; return 1; }
}
missing()  { grep -qE -- "$2" "$1" && { echo "did not expect /$2/"; return 1; }; return 0; }
exists()   { [ -e "$1" ] || { echo "no such path: $1"; return 1; }; }
refuses()  { # refuses <cmd...> -- must exit non-zero
  if "$@" > "$WORK/refused" 2>&1; then
    echo "expected failure, got success:"; cat "$WORK/refused"; return 1
  fi
  return 0
}

# ---- the sandbox ----------------------------------------------------------

WORK="$(mktemp -d "${TMPDIR:-/tmp}/tinyrust-check.XXXXXX")"
mkdir -p "$WORK/home" "$WORK/log"
cleanup() {
  if [ "$KEEP" = 1 ] || [ "$FAIL" -gt 0 ]; then
    printf '\n%s\n' "$(d "sandbox kept at $WORK")"
  else rm -rf "$WORK"; fi
}
trap cleanup EXIT

export HOME="$WORK/home"
export PATH="$HOME/.cargo/bin:$PATH"
# install.sh turns TINYRUST_DIST into TRUSTUP_DIST for the install and no
# further. Every later `rustup component add` is trustup invoked directly, and
# without this it goes to the published release instead -- which is how the
# first run of this file appeared to find a missing cargo-miri that was only
# missing from 0.1.0.
case "$DIST" in
  local) export TRUSTUP_DIST="$SRC/dist" ;;
  dir)
    # A dist straight out of `build-rustc dist` carries the URLs it will be
    # published under, and those 404 until the release exists. The tarballs are
    # right there, so copy them in and repoint the manifest at the copy. Hashes
    # are unaffected -- the files are untouched.
    [ -d "$DISTDIR" ] || { echo "check: no such dist: $DISTDIR" >&2; exit 2; }
    mkdir -p "$WORK/dist"
    cp "$DISTDIR"/*.tar.xz "$DISTDIR"/channel-rust-*.toml "$WORK/dist/"
    # BSD sed wants the backup suffix as its own argument, GNU sed will not
    # take one at all. Write to a new file instead of arguing with either.
    for m in "$WORK"/dist/channel-rust-*.toml; do
      sed "s|xz_url = \"[^\"]*/|xz_url = \"file://$WORK/dist/|" "$m" > "$m.new"
      mv "$m.new" "$m"
    done
    export TRUSTUP_DIST="$WORK/dist"
    ;;
esac
# A real rustup on the machine must not be reached; trustup goes out of its way
# to leave one alone, and here there is none to leave alone.
unset RUSTUP_HOME CARGO_HOME RUSTUP_TOOLCHAIN RUSTC CARGO 2>/dev/null || true

# ---- what this machine is -------------------------------------------------

OS="$(uname -s)"
case "$OS" in
  Darwin) TRIPLES='aarch64-apple-darwin|x86_64-apple-darwin'
          # The README claims 262 MB.
          MAX_MB=300 ;;
  *)      TRIPLES='aarch64-unknown-linux-gnu|x86_64-unknown-linux-gnu'
          # Linux starts from a larger std and a larger LLVM, so the same
          # build lands higher. Tighten this once a fat-LTO dist exists to
          # measure against.
          MAX_MB=330 ;;
esac
# A triple we do not publish, whatever host this is.
UNPUBLISHED=riscv64gc-unknown-linux-gnu

# The libraries a binary names -- a path on Mach-O, a soname on ELF -- and
# what it is allowed to name. macOS answers with directories because the OS
# ships one library; Linux answers with a list, because /usr/lib holds
# whatever the distribution put there. Kept in step with build-rustc's own
# copy: this is the same rule applied to the installed tree instead of the
# built one.
export OS
export SYSTEM_LIBS="ld-linux-aarch64.so.1 ld-linux-x86-64.so.2 libc.so.6 libm.so.6 libdl.so.2 libpthread.so.0 librt.so.1 libgcc_s.so.1 libz.so.1"

# rustc links through `cc`. A machine without one can install this toolchain
# and cannot build with it, which is a documented prerequisite rather than a
# bug -- so the steps that link are skipped there, and one step checks that
# the failure says so.
if command -v cc >/dev/null 2>&1; then
  OMIT="$OMIT nocc"
else
  OMIT="$OMIT cc"
fi

say "tinyrust check  ($DIST dist, $OS, sandbox $WORK)"
command -v cc >/dev/null 2>&1 || printf '  %s\n' "$(d 'no cc on this machine -- steps that link are skipped')"

# ---- install --------------------------------------------------------------

say "install"

it "installs without a prompt" "" '
  if [ -n "${TRUSTUP_DIST:-}" ]; then
    TINYRUST_SOURCE='"$SRC"' TINYRUST_DIST="$TRUSTUP_DIST" \
      sh '"$SRC"'/install.sh > install.out 2>&1
  else
    curl -sSfL https://dbarth.github.io/tinyrust/install.sh | sh > install.out 2>&1
  fi
  contains install.out "tinyrust installed"
'

it "puts the toolchain where rustup would look" "" '
  exists "$HOME/.rustup/toolchains/tinyrust/bin/rustc"
  exists "$HOME/.rustup/toolchains/tinyrust/bin/cargo"
  exists "$HOME/.rustup/toolchains/tinyrust/bin/rustdoc"
'

it "links into ~/.cargo/bin and the shell profile" "" '
  exists "$HOME/.cargo/bin/cargo"
  exists "$HOME/.cargo/bin/rustup"
  exists "$HOME/.cargo/env"
  test -L "$HOME/.cargo/bin/rustup"
'

it "leaves nothing outside the sandbox" "" '
  test "$(readlink "$HOME/.cargo/bin/cargo")" != ""
  case "$(readlink "$HOME/.cargo/bin/cargo")" in
    "$HOME"/*) ;;
    *) echo "cargo links outside HOME: $(readlink "$HOME/.cargo/bin/cargo")"; exit 1 ;;
  esac
'

it "reports a version" "" '
  rustc --version > v.out 2>&1
  contains v.out "^rustc 1\."
  cargo --version >> v.out 2>&1
  contains v.out "^cargo 1\."
'

it "shows info without crashing" "" '
  trustup info > info.out 2>&1
  contains info.out "rustc"
  contains info.out "$TRIPLES"
'

# `trim` is a separate step from `build`, so it is possible to package a tree
# that still holds all 15 llvm-tools -- 208 MB of them, llc and opt alone being
# 118 -- and nothing downstream notices. That shipped twice before this existed.
# On macOS rustc shells out to rust-objcopy for -Cstrip, so exactly that one
# binary earns its place. On Linux it shells out to nothing and the directory
# ships empty -- the official Linux dist puts 13.8 MB there.
it "ships only the llvm-tools something calls" "" '
  p="$HOME/.rustup/toolchains/tinyrust"
  case "$OS" in Darwin) want="rust-objcopy " ;; *) want="" ;; esac
  for d in "$p"/lib/rustlib/*/bin; do
    [ -d "$d" ] || continue
    got="$(ls "$d" | tr "\n" " ")"
    [ "$got" = "$want" ] || { echo "$d holds: [$got], wanted [$want]"; exit 1; }
  done
'

it "installs in the size the README claims" "" '
  n=$(du -sm "$HOME/.rustup/toolchains/tinyrust" | awk "{print \$1}")
  echo "installed ${n} MB"
  [ "$n" -le '"$MAX_MB"' ] || { echo "too big: ${n} MB -- ceiling is '"$MAX_MB"'"; exit 1; }
'

it "ships no binary that links outside the OS" "" '
  p="$HOME/.rustup/toolchains/tinyrust"
  deps() { case "$OS" in
             Darwin) otool -L "$1" 2>/dev/null | tail -n +2 | awk "{print \$1}" ;;
             *) readelf -d "$1" 2>/dev/null | sed -n "s/.*(NEEDED).*\[\(.*\)\]/\1/p" ;;
           esac; }
  own() { case "$OS" in
            Darwin) otool -D "$1" 2>/dev/null | tail -n +2 | head -1 ;;
            *) readelf -d "$1" 2>/dev/null | sed -n "s/.*(SONAME).*\[\(.*\)\]/\1/p" ;;
          esac; }
  # Where a name that is not a system library is looked up. bin/rustc names
  # librustc_driver by soname alone and finds it through RUNPATH in the
  # toolchain own lib -- allowed, and the reason this cannot stop at the
  # system list.
  rpaths() { readelf -d "$1" 2>/dev/null \
               | sed -n "s/.*R\(UN\)\?PATH.*\[\(.*\)\]/\2/p" | tr ":" "\n" \
               | sed "s|[\$]ORIGIN|$(dirname "$1")|g"; }
  bad=0
  while IFS= read -r f; do
    case "$(file -b "$f" 2>/dev/null)" in *Mach-O*|*ELF*) ;; *) continue ;; esac
    id="$(own "$f")"
    while IFS= read -r dep; do
      [ -n "$id" ] && [ "$dep" = "$id" ] && continue
      [ -z "$dep" ] && continue
      if [ "$OS" = Darwin ]; then
        case "$dep" in
          /usr/lib/*|/System/*) continue ;;
          @rpath/*) continue ;;
          @loader_path/*|@executable_path/*)
            [ -e "$(dirname "$f")/${dep#@*path/}" ] && continue
            echo "DANGLING $f -> $dep"; bad=1; continue ;;
        esac
        echo "LEAK $f -> $dep"; bad=1
      else
        case " $SYSTEM_LIBS " in *" $dep "*) continue ;; esac
        found=0
        for rp in $(rpaths "$f"); do [ -e "$rp/$dep" ] && { found=1; break; }; done
        [ "$found" = 1 ] && continue
        echo "LEAK $f -> $dep"; bad=1
      fi
    done < <(deps "$f")
  done < <(find "$p/bin" "$p/lib" -type f \
            \( -perm -u+x -o -name "*.dylib" -o -name "*.so" -o -name "*.so.*" \) 2>/dev/null)
  [ "$bad" = 0 ]
'

# The Linux half of the same question, and the one a dependency list cannot
# answer: the glibc a binary was built against lives in its symbols. A
# toolchain that names only allowed libraries still will not start on a
# machine older than its build image.
it "needs no glibc newer than the floor" "" '
  [ "$OS" = Darwin ] && exit 0
  p="$HOME/.rustup/toolchains/tinyrust"
  floor=""
  while IFS= read -r f; do
    case "$(file -b "$f" 2>/dev/null)" in *ELF*) ;; *) continue ;; esac
    v="$(objdump -T "$f" 2>/dev/null | grep -o "GLIBC_[0-9][0-9.]*" | sed "s/GLIBC_//" | sort -uV | tail -1)"
    [ -n "$v" ] || continue
    floor="$(printf "%s\n%s\n" "$floor" "$v" | sort -uV | tail -1)"
  done < <(find "$p/bin" "$p/lib" -type f \
            \( -perm -u+x -o -name "*.so" -o -name "*.so.*" \) 2>/dev/null)
  echo "oldest glibc that will run this: $floor"
  [ "$(printf "%s\n%s\n" "$floor" "2.34" | sort -V | tail -1)" = "2.34" ] \
    || { echo "needs glibc $floor, ceiling is 2.34"; exit 1; }
'

# ---- hello world ----------------------------------------------------------

say "build something"

it "creates a new crate" "" '
  cargo new --quiet hello
  exists hello/Cargo.toml
  exists hello/src/main.rs
'

it "runs it" "cc" '
  cd hello
  cargo run --quiet > run.out 2>&1
  contains run.out "Hello, world!"
'

it "builds a release binary with strip = true" "cc" '
  cd hello
  printf "\n[profile.release]\nstrip = true\n" >> Cargo.toml
  cargo build --release --quiet 2>&1 | tee strip.out
  missing strip.out "unable to run rust-objcopy"
  exists target/release/hello
  ./target/release/hello | grep -q "Hello, world!"
'

it "runs unit tests" "cc" '
  cd hello
  cat >> src/main.rs <<EOF

#[cfg(test)]
mod tests {
    #[test]
    fn two() { assert_eq!(1 + 1, 2); }
}
EOF
  cargo test --quiet > test.out 2>&1
  contains test.out "test result: ok"
'

it "runs doctests through rustdoc" "cc" '
  cd hello
  cat > src/lib.rs <<EOF
/// Adds two numbers.
///
/// \`\`\`
/// assert_eq!(hello::add(2, 2), 4);
/// \`\`\`
pub fn add(a: i32, b: i32) -> i32 { a + b }
EOF
  cargo test --doc --quiet > doc.out 2>&1
  contains doc.out "test result: ok"
'

it "builds documentation" "" '
  cd hello
  cargo doc --no-deps --quiet > cargodoc.out 2>&1
  exists target/doc/hello/index.html
'

it "benchmarks with a harness-free bench target" "cc" '
  cd hello
  mkdir -p benches
  cat > benches/b.rs <<EOF
fn main() {
    let t = std::time::Instant::now();
    let mut n: u64 = 0;
    for i in 0..2_000_000u64 { n = n.wrapping_add(i); }
    println!("sum {} in {:?}", n, t.elapsed());
}
EOF
  printf "\n[[bench]]\nname = \"b\"\nharness = false\n" >> Cargo.toml
  cargo bench --quiet > bench.out 2>&1
  contains bench.out "sum .* in "
'

it "adds a dependency from crates.io" "net,cc" '
  cd hello
  cargo add serde --quiet 2>&1 | tee add.out
  cargo build --quiet > dep.out 2>&1
  contains Cargo.toml "serde"
'

# The other side of the same fact: on a machine with no C toolchain the
# toolchain installs, runs and refuses to link -- and has to say which of
# those it is. Runs only where there is no cc, which is what --in is for.
it "says what is missing when there is no linker" "nocc" '
  cargo new --quiet nolink
  cd nolink
  cargo build > nolink.out 2>&1 && { echo "expected a failure"; exit 1; }
  contains nolink.out "linker .?cc.? not found"
'

# ---- components -----------------------------------------------------------

say "components"

it "lists components, installed and on offer" "" '
  rustup component list > cl.out 2>&1
  contains cl.out "clippy-preview"
  contains cl.out "rustfmt-preview"
'

it "adds clippy and lints with it" "" '
  rustup component add clippy-preview > clippy-add.out 2>&1
  cd hello && cargo clippy --quiet > clippy.out 2>&1
  missing clippy.out "error: "
'

it "adds rustfmt and formats with it" "" '
  rustup component add rustfmt-preview > fmt-add.out 2>&1
  cd hello
  # --check first, on the code earlier steps wrote by hand, so the run that
  # follows has something to do. Then --check again, which must come back clean.
  cargo fmt --check > before.out 2>&1 || true
  contains before.out "Diff in"
  cargo fmt > fmt.out 2>&1
  cargo fmt --check > after.out 2>&1
'

it "adds rust-analyzer and it starts" "" '
  rustup component add rust-analyzer-preview > ra-add.out 2>&1
  rust-analyzer --version > ra.out 2>&1
  contains ra.out "rust-analyzer"
'

# `cargo miri` is the only way anyone runs miri. Shipping bin/miri alone gives
# a component that lists as installed and answers "no such command" -- which is
# exactly what this step found the first time it ran.
it "adds miri and cargo miri works" "" '
  rustup component add miri > miri-add.out 2>&1
  exists "$HOME/.rustup/toolchains/tinyrust/bin/miri"
  exists "$HOME/.rustup/toolchains/tinyrust/bin/cargo-miri"
  cd hello && cargo miri --version > m.out 2>&1
  missing m.out "no such command"
'

it "adds rust-src from the official dist" "net" '
  rustup component add rust-src > src-add.out 2>&1
  exists "$HOME/.rustup/toolchains/tinyrust/lib/rustlib/src"
'

it "removes a component again" "" '
  rustup component remove miri > rm.out 2>&1
  test ! -e "$HOME/.rustup/toolchains/tinyrust/bin/miri"
'

it "still builds after all that" "cc" '
  cd hello && cargo build --quiet > after.out 2>&1
  ./target/debug/hello | grep -q "Hello, world!"
'

# ---- targets --------------------------------------------------------------

say "targets"

it "lists the targets the dist offers" "" '
  rustup target list > tl.out 2>&1
  contains tl.out "$TRIPLES"
'

# x86_64-unknown-linux-gnu used to be the example here, and once the Linux
# hosts publish it, it is a target we carry. rust-std is keyed by target and
# is interchangeable across hosts, so a Mac can install the Linux std -- and
# then fail at link for want of a cross linker, which is what rustup does too.
# The target that must still be refused is one nobody builds.
it "refuses a target the dist does not carry" "" '
  refuses rustup target add '"$UNPUBLISHED"'
  contains "$WORK/refused" "no rust-std|not published|does not"
'

# The interesting one. Until the other host has published, a release carries
# no std for it, and the wrong answer is to quietly take the official one --
# it would be built by a different compiler and every crate would fail with
# E0514. So this asserts whichever is true of the dist under test.
#
# Whether the build then works is a second question, and the two platforms
# answer it differently. Apple ships one universal SDK and linker, so cross
# between the two Mac targets costs nothing. On Linux the linker is per
# architecture and is not ours to ship, so `target add` succeeds -- the std is
# real and interchangeable -- and the build needs a cross linker the machine
# may not have. That is what stock rustup does too, so a missing cross linker
# is reported, not failed.
it "cross-compiles, or says why it cannot" "cc" '
  case "$OS" in
    Darwin) other=x86_64-apple-darwin
            [ "$(uname -m)" = x86_64 ] && other=aarch64-apple-darwin
            xcc="" ;;
    *)      other=x86_64-unknown-linux-gnu; xcc=x86_64-linux-gnu-gcc
            [ "$(uname -m)" = x86_64 ] && { other=aarch64-unknown-linux-gnu
                                            xcc=aarch64-linux-gnu-gcc; } ;;
  esac
  if ! rustup target add "$other" > ta.out 2>&1; then
    contains ta.out "no rust-std for $other"
    echo "not published for $other yet, and it said so"
    exit 0
  fi
  exists "$HOME/.rustup/toolchains/tinyrust/lib/rustlib/$other/lib"
  if [ -n "$xcc" ] && ! command -v "$xcc" >/dev/null 2>&1; then
    echo "std for $other installed; no $xcc here, so not linking it"
    exit 0
  fi
  cd hello
  [ -n "$xcc" ] && { mkdir -p .cargo
    printf "[target.%s]\nlinker = \"%s\"\n" "$other" "$xcc" > .cargo/config.toml; }
  cargo build --quiet --target "$other" > cross.out 2>&1
  exists "target/$other/debug/hello"
  echo "cross-compiled to $other"
'

# ---- handing over to rustup ----------------------------------------------

say "the rest of rustup"

it "fetches the real rustup on demand" "net,heavy" '
  rustup toolchain list > tc.out 2>&1
  contains tc.out "tinyrust"
'

it "survives a second install" "cc" '
  if [ -n "${TRUSTUP_DIST:-}" ]; then
    TINYRUST_SOURCE='"$SRC"' TINYRUST_DIST="$TRUSTUP_DIST" \
      sh '"$SRC"'/install.sh > reinstall.out 2>&1
  else
    curl -sSfL https://dbarth.github.io/tinyrust/install.sh | sh > reinstall.out 2>&1
  fi
  contains reinstall.out "tinyrust installed"
  cd hello && cargo build --quiet > again.out 2>&1
'

# ---- report ---------------------------------------------------------------

printf '\n'
if [ "$FAIL" -eq 0 ]; then
  printf '%s  %d passed' "$(g "$TICK")" "$PASS"
else
  printf '%s  %d failed, %d passed' "$(r "$CROSS")" "$FAIL" "$PASS"
fi
[ "$SKIP" -gt 0 ] && printf ', %d skipped' "$SKIP"
printf '\n'
if [ "$FAIL" -gt 0 ]; then printf '\n%b' "$FAILED"; fi
exit $(( FAIL > 0 ))
