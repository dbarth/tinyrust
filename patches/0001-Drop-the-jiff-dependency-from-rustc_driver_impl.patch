 Cargo.lock                            |  1 -
 compiler/rustc_driver_impl/Cargo.toml |  1 -
 compiler/rustc_driver_impl/src/lib.rs | 25 ++++++++++++++++++++++---
 src/tools/tidy/src/deps.rs            |  3 ---
 4 files changed, 22 insertions(+), 8 deletions(-)

