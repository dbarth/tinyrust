diff --git a/compiler/rustc_log/Cargo.toml b/compiler/rustc_log/Cargo.toml
index d407351f..41eb6d10 100644
--- a/compiler/rustc_log/Cargo.toml
+++ b/compiler/rustc_log/Cargo.toml
@@ -7,11 +7,16 @@ edition = "2024"
 # tidy-alphabetical-start
 tracing = "0.1.41"
 tracing-core = "0.1.34"
-tracing-subscriber = { version = "0.3.3", default-features = false, features = ["fmt", "env-filter", "smallvec", "parking_lot", "ansi", "json"] }
-tracing-tree = "0.3.1"
+tracing-subscriber = { version = "0.3.3", default-features = false, features = ["fmt", "env-filter", "smallvec", "parking_lot", "ansi", "json"], optional = true }
+tracing-tree = { version = "0.3.1", optional = true }
 # tidy-alphabetical-end
 
 [features]
 # tidy-alphabetical-start
+default = ['subscriber']
 max_level_info = ['tracing/max_level_info', 'tracing/release_max_level_info']
+# The log subscriber itself: `tracing-subscriber`'s `EnvFilter` and `tracing-tree`. Without it
+# `init_logger` is a stub, and rustc emits no logs. Everything else this crate offers -- the
+# `tracing` re-export tools compile against, `LoggerConfig` -- stays.
+subscriber = ['dep:tracing-subscriber', 'dep:tracing-tree']
 # tidy-alphabetical-end
