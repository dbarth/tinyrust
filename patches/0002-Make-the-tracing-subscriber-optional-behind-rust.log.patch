diff --git a/bootstrap.example.toml b/bootstrap.example.toml
index 1ca4bc91..74a0c86f 100644
--- a/bootstrap.example.toml
+++ b/bootstrap.example.toml
@@ -658,6 +658,14 @@
 # are disabled statically" because `max_level_info` is enabled, set this value to `true`.
 #rust.debug-logging = rust.debug-assertions (boolean)
 
+# Whether to link a tracing subscriber into the compiler at all.
+#
+# With this off, `rustc_log` is built without `tracing-subscriber` and `tracing-tree`, `RUSTC_LOG`
+# has no effect (rustc warns if it is set), and `librustc_driver` is a few hundred KB smaller.
+# `rust.debug-logging` is about which `debug!`/`trace!` call sites survive compilation; this is
+# about whether anything is listening.
+#rust.logging = true
+
 # Whether or not to build rustc, tools and the libraries with randomized type layout
 #rust.randomize-layout = false
 
