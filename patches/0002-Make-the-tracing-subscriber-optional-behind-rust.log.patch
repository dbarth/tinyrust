 ) {
+    // `logging` is the only default feature of `rustc-main`, so dropping the defaults is how
+    // it is turned off; `rustc_features` can only add features, never remove them.
+    if !builder.config.rust_logging {
+        cargo.arg("--no-default-features");
+    }
+
