-icu_list = { version = "2.2", default-features = false, features = ["alloc"] }
-icu_locale = { version = "2.2", default-features = false }
+icu_list = { version = "2.2", default-features = false, features = ["alloc"], optional = true }
+icu_locale = { version = "2.2", default-features = false, optional = true }
 intl-memoizer = "0.5.1"
-rustc_baked_icu_data = { path = "../rustc_baked_icu_data" }
+rustc_baked_icu_data = { path = "../rustc_baked_icu_data", optional = true }
 rustc_data_structures = { path = "../rustc_data_structures" }
 rustc_macros = { path = "../rustc_macros" }
 rustc_serialize = { path = "../rustc_serialize" }
