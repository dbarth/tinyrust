diff --git a/src/bootstrap/src/lib.rs b/src/bootstrap/src/lib.rs
index 2231e088..af39d4b5 100644
--- a/src/bootstrap/src/lib.rs
+++ b/src/bootstrap/src/lib.rs
@@ -902,6 +902,12 @@ fn rustc_features(&self, kind: Kind, target: TargetSelection, crates: &[String])
             features.push("max_level_info");
         }
 
+        // ICU is only needed to format Fluent lists for a locale rustc does not ship messages
+        // for. Off, the English formatting ICU would have produced is used instead.
+        if self.config.rust_icu && check("icu") {
+            features.push("icu");
+        }
+
         features.join(" ")
     }
 
