 unic-langid = { version = "0.9.0", features = ["macros"] }
 # tidy-alphabetical-end
+
+[features]
+# tidy-alphabetical-start
+# Locale-correct list formatting for the Fluent `STRLIST` values in diagnostics. Without it
+# lists are formatted the way ICU formats them for `en`, and the ICU data and the crates that
+# read it are not linked. Enabled by bootstrap unless `rust.icu` is false, the same way
+# `max_level_info` is.
+icu = ['dep:icu_list', 'dep:icu_locale', 'dep:rustc_baked_icu_data']
+# tidy-alphabetical-end
diff --git a/compiler/rustc_error_messages/src/lib.rs b/compiler/rustc_error_messages/src/lib.rs
index 2722db06..c69517f8 100644
--- a/compiler/rustc_error_messages/src/lib.rs
+++ b/compiler/rustc_error_messages/src/lib.rs
@@ -219,10 +219,24 @@ fn from(spans: Vec<Span>) -> MultiSpan {
     }
 }
 
+#[cfg(feature = "icu")]
 fn icu_locale_from_unic_langid(lang: LanguageIdentifier) -> Option<icu_locale::Locale> {
     icu_locale::Locale::try_from_str(&lang.to_string()).ok()
 }
 
+/// English list formatting, for a build without the `icu` feature. This is what ICU produces
+/// for the `en` locale, which is also the fallback ICU is asked for when the requested locale
+/// is unknown.
+#[cfg(not(feature = "icu"))]
+fn list_sep_by_and(list: &[String]) -> String {
+    match list {
+        [] => String::new(),
+        [one] => one.clone(),
+        [one, two] => format!("{one} and {two}"),
+        [rest @ .., last] => format!("{}, and {last}", rest.join(", ")),
+    }
+}
+
 pub fn fluent_value_from_str_list_sep_by_and(l: Vec<Cow<'_, str>>) -> FluentValue<'_> {
     // Fluent requires 'static value here for its AnyEq usages.
     #[derive(Clone, PartialEq, Debug)]
@@ -233,6 +247,7 @@ fn duplicate(&self) -> Box<dyn FluentType + Send> {
             Box::new(self.clone())
         }
 
+        #[cfg(feature = "icu")]
         fn as_string(&self, intls: &intl_memoizer::IntlLangMemoizer) -> Cow<'static, str> {
             let result = intls
                 .with_try_get::<MemoizableListFormatter, _, _>((), |list_formatter| {
@@ -242,6 +257,12 @@ fn as_string(&self, intls: &intl_memoizer::IntlLangMemoizer) -> Cow<'static, str
             Cow::Owned(result)
         }
 
+        #[cfg(not(feature = "icu"))]
+        fn as_string(&self, _intls: &intl_memoizer::IntlLangMemoizer) -> Cow<'static, str> {
+            Cow::Owned(list_sep_by_and(&self.0))
+        }
+
+        #[cfg(feature = "icu")]
         fn as_string_threadsafe(
             &self,
             intls: &intl_memoizer::concurrent::IntlLangMemoizer,
@@ -253,10 +274,20 @@ fn as_string_threadsafe(
                 .unwrap();
             Cow::Owned(result)
         }
+
+        #[cfg(not(feature = "icu"))]
+        fn as_string_threadsafe(
+            &self,
+            _intls: &intl_memoizer::concurrent::IntlLangMemoizer,
+        ) -> Cow<'static, str> {
+            Cow::Owned(list_sep_by_and(&self.0))
+        }
     }
 
+    #[cfg(feature = "icu")]
     struct MemoizableListFormatter(icu_list::ListFormatter);
 
+    #[cfg(feature = "icu")]
     impl std::ops::Deref for MemoizableListFormatter {
         type Target = icu_list::ListFormatter;
         fn deref(&self) -> &Self::Target {
@@ -264,6 +295,7 @@ fn deref(&self) -> &Self::Target {
         }
     }
 
+    #[cfg(feature = "icu")]
     impl intl_memoizer::Memoizable for MemoizableListFormatter {
         type Args = ();
         type Error = ();
