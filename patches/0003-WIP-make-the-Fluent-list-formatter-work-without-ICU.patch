 rustc_driver = { path = "../rustc_driver" }
 rustc_driver_impl = { path = "../rustc_driver_impl" }
 
+# Not used here. `rustc_error_messages` is deep in the graph, so this is where bootstrap
+# reaches its `icu` feature when it builds the whole compiler at once.
+rustc_error_messages = { path = "../rustc_error_messages" }
+
 rustc_public = { path = "../rustc_public" }
 
