+# Whether to link ICU into the compiler for locale-correct list formatting in diagnostics.
+#
+# With this off, the `icu_list`, `icu_locale` and `rustc_baked_icu_data` crates are not linked and
+# Fluent lists are formatted the English way ("a, b, and c"), which is what ICU produces for the
+# only locale rustc ships messages for. Turn it off only if you do not point `-Ztranslate-lang`
+# at a translation of your own.
+#rust.icu = true
+
 # Whether or not to build rustc, tools and the libraries with randomized type layout
 #rust.randomize-layout = false
 
diff --git a/compiler/rustc/Cargo.toml b/compiler/rustc/Cargo.toml
index 8cef9e06..28fe5664 100644
