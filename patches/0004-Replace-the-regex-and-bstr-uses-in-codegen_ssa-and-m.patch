+/// How a linker spells a flag it does not know: what the regex
+/// `(unknown|unrecognized) (command line )?(option|argument)` matched.
+fn is_unknown_arg_error(out: &str) -> bool {
+    let names_a_flag = |rest: &str| {
+        let rest = rest.strip_prefix("command line ").unwrap_or(rest);
+        rest.starts_with("option") || rest.starts_with("argument")
+    };
+    ["unknown ", "unrecognized "]
+        .iter()
+        .any(|word| out.match_indices(word).any(|(i, _)| names_a_flag(&out[i + word.len()..])))
+}
