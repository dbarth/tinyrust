+/// The first `-` followed by lowercase hex, replaced by `-*`: what the regex
+/// `-[0-9a-f]+` did to a crate hash.
+fn strip_crate_hash(name: &[u8]) -> Vec<u8> {
+    let is_hex = |b: u8| b.is_ascii_digit() || matches!(b, b'a'..=b'f');
+    let mut i = 0;
+    while let Some(off) = name[i..].iter().position(|&b| b == b'-') {
+        let dash = i + off;
+        let end = dash + 1 + name[dash + 1..].iter().take_while(|&&b| is_hex(b)).count();
+        if end > dash + 1 {
+            let mut out = Vec::with_capacity(name.len());
+            out.extend_from_slice(&name[..dash]);
+            out.extend_from_slice(b"-*");
+            out.extend_from_slice(&name[end..]);
+            return out;
+        }
+        i = dash + 1;
+    }
+    name.to_vec()
+}
+
+/// Every occurrence of `needle` replaced by `to`.
+fn replace_bytes(haystack: &[u8], needle: &[u8], to: &[u8]) -> Vec<u8> {
+    if needle.is_empty() {
+        return haystack.to_vec();
+    }
+    let mut out = Vec::with_capacity(haystack.len());
+    let mut i = 0;
+    while i < haystack.len() {
+        if haystack[i..].starts_with(needle) {
+            out.extend_from_slice(to);
+            i += needle.len();
+        } else {
+            out.push(haystack[i]);
+            i += 1;
+        }
+    }
+    out
+}
