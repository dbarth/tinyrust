+/// The next `\t?\u{001f}[+-]` in `s`: what the diff writer marks a changed
+/// line with. Returns the byte range to replace and the sign.
+fn diff_marker(s: &str) -> Option<(usize, usize, u8)> {
+    let bytes = s.as_bytes();
+    let mut i = 0;
+    while let Some(off) = bytes[i..].iter().position(|&b| b == 0x1f) {
+        let sep = i + off;
+        match bytes.get(sep + 1) {
+            Some(&sign @ (b'+' | b'-')) => {
+                let start = if sep > 0 && bytes[sep - 1] == b'\t' { sep - 1 } else { sep };
+                return Some((start, sep + 2, sign));
+            }
+            _ => i = sep + 1,
+        }
+    }
+    None
 }
 
