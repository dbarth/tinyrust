-
-        let tag = match &captures[1] {
-            "+" => r#"<font color="darkgreen">+"#,
-            "-" => r#"<font color="red">-"#,
-            _ => unreachable!(),
-        };
-
+        html_diff.push_str(match sign {
+            b'+' => r#"<font color="darkgreen">+"#,
+            _ => r#"<font color="red">-"#,
+        });
         inside_font_tag = true;
-        ret.push_str(tag);
