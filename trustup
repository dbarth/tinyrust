#!/usr/bin/env bash
#
# trustup -- install the smallest Rust toolchain that still builds for THIS
# machine, and nothing else.
#
#   trustup install [DIR]     fetch the three components directly (default)
#   trustup install --rustup  drive rustup, then delete what it over-installed
#   trustup trim              remove what a build never reads (--rustup only)
#   trustup component list    what is installed, and what else is on offer
#   trustup component add N   add one
#   trustup size              where the bytes are
#   trustup env               shell lines to use it
#
# Everything lives under one directory. Nothing touches ~/.rustup, ~/.cargo or
# PATH -- `trustup env` prints what to source, and removing the directory
# removes the toolchain.
#
# See README.md for what cannot be made smaller and why.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${TRUSTUP_ROOT:-$HERE/toolchain}"

CHANNEL="${TRUSTUP_CHANNEL:-stable}"
DIST="https://static.rust-lang.org/dist"

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
die()  { printf 'trustup: %s\n' "$*" >&2; exit 1; }
mb()   { du -sm "$@" 2>/dev/null | awk '{s+=$1} END {print s+0}'; }

# The host triple, from the machine rather than from a guess. This is the whole
# point: rustup ships one rustc that can emit for 330 targets, and exactly one
# of them is ever used here.
host_triple() {
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64)  echo aarch64-apple-darwin ;;
    Darwin/x86_64) echo x86_64-apple-darwin ;;
    Linux/aarch64) echo aarch64-unknown-linux-gnu ;;
    Linux/x86_64)  echo x86_64-unknown-linux-gnu ;;
    *) die "unknown host $(uname -s)/$(uname -m)" ;;
  esac
}

# Files a build never opens, excluded during extraction so they are never
# written at all. Each was measured; `trustup size` prints what is left.
#
# rustdoc and share/doc go because this installs a compiler, not a
# documentation system. The sanitizer runtimes go because they are linked only
# by -Zsanitizer, which is nightly-only. wasm-component-ld goes because it is
# reachable only from a wasm target that is not installed.
#
# NOT excluded, and worth saying why: rust-lld is the default linker for some
# targets and the fallback for others, and libcore's 61 MB .rmeta is the MIR
# every generic instantiation is built from -- drop it and the first `Vec<T>`
# anyone writes fails to compile.
SKIP=(
  --exclude '*/bin/rustdoc'
  --exclude '*/share/doc'
  --exclude '*/librustc-*_rt.*'
  --exclude '*/bin/wasm-component-ld'
)

# ---- direct: three tarballs, no rustup ------------------------------------

# One field out of the channel manifest. The file is a TOML index of every
# component for every target; the entries are regular enough that a parser
# would be ceremony.
manifest_field() {
  local pkg="$1" triple="$2" field="$3" mf="$4"
  python3 - "$pkg" "$triple" "$field" "$mf" "$0" <<'PY'
import re, sys
pkg, triple, field, mf, me = sys.argv[1:6]
s = open(mf, encoding="utf-8").read()
head = f"[pkg.{pkg}.target.{triple}]"
i = s.find(head)
if i < 0:
    sys.exit(f"trustup: {pkg} is not published for {triple}")
body = s[i + len(head):]
body = body[:body.find("\n[")]
m = re.search(rf'{field} = "([^"]+)"', body)
if not m:
    # The entry exists but carries no artefact: the component is real, just not
    # built for this target on this channel. cranelift, for one, is nightly.
    if "available = false" in body:
        sys.exit(f"trustup: {pkg} is not available for {triple} on this channel\n"
                 f"  some components are nightly-only -- try:\n"
                 f"  TRUSTUP_CHANNEL=nightly {me} install && {me} component add {pkg}")
    sys.exit(f"trustup: no {field} for {pkg}/{triple}")
print(m.group(1))
PY
}

fetch_component() {
  local pkg="$1" triple="$2" mf="$3" dest="$4" work="$5" prune="${6:-yes}"
  local url hash tarball got

  url="$(manifest_field "$pkg" "$triple" xz_url "$mf")"
  hash="$(manifest_field "$pkg" "$triple" xz_hash "$mf")"
  tarball="$work/$(basename "$url")"

  note "$pkg"
  curl -sSfL -o "$tarball" "$url" || die "could not download $url"

  # Verified here rather than trusted: this is the one thing rustup does that
  # a plain download does not.
  got="$(shasum -a 256 "$tarball" | cut -d' ' -f1)"
  [ "$got" = "$hash" ] || die "$pkg checksum mismatch
     expected $hash
     got      $got"

  # strip 2: the archive is <pkg>-<version>-<triple>/<component>/<files>, and
  # only <files> belongs under the prefix.
  # Pruned only for the three that come by default. A component somebody asked
  # for by name is extracted whole -- asking for rust-docs and getting nothing
  # because share/doc is on the skip list would be a poor joke.
  if [ "$prune" = yes ]; then
    tar -xJf "$tarball" -C "$dest" --strip-components=2 "${SKIP[@]}"
  else
    tar -xJf "$tarball" -C "$dest" --strip-components=2
  fi
  rm -f "$tarball"

  # There is no package database here, so keep the one fact that cannot be
  # recovered from the files afterwards: which components were asked for.
  grep -qxF "$pkg" "$dest/.trustup-components" 2>/dev/null \
    || printf '%s\n' "$pkg" >> "$dest/.trustup-components"
}

cmd_install_direct() {
  local triple; triple="$(host_triple)"
  # NOT named after the triple. rustc finds its sysroot by walking up from its
  # own path, and treats `<sysroot>/lib/rustlib/<triple>/bin/rustc` as a
  # special case -- a prefix called `aarch64-apple-darwin` trips that rule and
  # the sysroot lands four directories too high.
  local dest="$ROOT/rust-$CHANNEL"
  say "installing $CHANNEL for $triple into $dest"
  mkdir -p "$dest"

  local work; work="$(mktemp -d)"
  trap 'rm -rf "$work"' RETURN

  local mf="$work/channel.toml"
  curl -sSfL -o "$mf" "$DIST/channel-rust-$CHANNEL.toml" \
    || die "could not fetch the $CHANNEL manifest"
  note "manifest $(mb "$mf") MB, dated $(sed -n 's/^date = "\(.*\)"/\1/p' "$mf" | head -1)"

  # Three components, and there is no fourth worth having: rustc carries the
  # compiler and its LLVM, rust-std the library for this target, cargo the
  # build tool. rust-docs is a package of its own, which is why 893 MB of HTML
  # is never even requested.
  local pkg
  for pkg in rustc rust-std cargo; do
    fetch_component "$pkg" "$triple" "$mf" "$dest" "$work"
  done

  # rust-objcopy lives in lib/rustlib/<triple>/bin and has an rpath of
  # @loader_path/../lib, but libLLVM.dylib ships in the prefix's own lib. cargo
  # calls it to strip release binaries, so without this it warns on every build.
  local tb
  for tb in "$dest"/lib/rustlib/*/bin; do
    [ -d "$tb" ] || continue
    mkdir -p "$tb/../lib"
    ln -sf ../../../libLLVM.dylib "$tb/../lib/libLLVM.dylib"
  done

  printf '%s\n' "$CHANNEL" > "$dest/.trustup-channel"
  say "installed: $(mb "$dest") MB"
  note "use it with: eval \"\$($0 env)\""
}

# ---- rustup: the old way, kept for comparison ------------------------------

cmd_install_rustup() {
  export RUSTUP_HOME="$ROOT/rustup" CARGO_HOME="$ROOT/cargo"
  local triple; triple="$(host_triple)"
  say "installing via rustup for $triple into $ROOT"
  mkdir -p "$ROOT"
  local init="$ROOT/rustup-init.sh"
  [ -f "$init" ] || curl -sSfL "https://sh.rustup.rs" -o "$init"

  # --profile minimal is the only knob that matters here: rustc + cargo +
  # rust-std and nothing else. The default profile adds rust-docs.
  sh "$init" -y --no-modify-path --profile minimal \
     --default-toolchain "$CHANNEL" --default-host "$triple" >/dev/null

  note "installed: $(mb "$ROOT") MB"
  say "now run: $0 trim"
}

# Only meaningful after --rustup: the direct install never writes these.
cmd_trim() {
  local tc; tc="$(echo "$ROOT"/rustup/toolchains/*/)"
  [ -d "$tc" ] || die "trim applies to a --rustup install; the direct one skips these already"
  local before; before="$(mb "$ROOT")"

  say "trimming $tc"
  for path in "$tc/bin/rustdoc" "$tc/share/doc" \
              "$tc/lib/rustlib/"*/bin/wasm-component-ld \
              "$tc"/lib/librustc-*_rt.*; do
    [ -e "$path" ] || continue
    note "$(basename "$path") -- $(mb "$path") MB"
    rm -rf "$path"
  done
  say "$before MB -> $(mb "$ROOT") MB"
}

# ---- adding a component ----------------------------------------------------

# `rustup component add` and `component list`, for an install that has no
# rustup -- and a straight pass-through to the real one when there is.
#
# A component must match the toolchain it joins -- the manifest publishes one
# version per channel per day -- so this reads the channel recorded at install
# time rather than whatever TRUSTUP_CHANNEL happens to say now.
#
# `list` reads what the manifest offers for this target, which is what
# `rustup component list` reports from the same data.
cmd_component() {
  local verb="${1:-list}"; shift || true
  case "$verb" in
    add|list) ;;
    *) die "component takes 'add' or 'list', not '$verb'" ;;
  esac
  [ "$verb" = add ] && [ $# -eq 0 ] && die "component add needs a name -- '$0 component list' shows them"

  local p; p="$(prefix)"

  # A --rustup install has the real thing; pass straight through to it.
  if [ -d "$ROOT/rustup" ]; then
    export RUSTUP_HOME="$ROOT/rustup" CARGO_HOME="$ROOT/cargo"
    exec "$CARGO_HOME/bin/rustup" component "$verb" "$@"
  fi

  local triple; triple="$(host_triple)"
  local channel; channel="$(cat "$p/.trustup-channel" 2>/dev/null || echo "$CHANNEL")"

  local work; work="$(mktemp -d)"
  trap 'rm -rf "$work"' RETURN
  local mf="$work/channel.toml"
  curl -sSfL -o "$mf" "$DIST/channel-rust-$channel.toml" \
    || die "could not fetch the $channel manifest"

  if [ "$verb" = list ]; then
    say "components for $triple on $channel"
    python3 - "$triple" "$mf" "$p/.trustup-components" <<'INNER'
import os, re, sys
triple, mf, have_file = sys.argv[1:4]
have = set()
if os.path.exists(have_file):
    have = {l.strip() for l in open(have_file) if l.strip()}
s = open(mf, encoding="utf-8").read()
pat = r'\[pkg\.([^.\]]+)\.target\.' + re.escape(triple) + r'\](.*?)(?=\n\[)'
for pkg, body in re.findall(pat, s, re.S):
    if pkg in have:   note = "  (installed)"
    elif "available = true" in body: note = ""
    else: note = "  (not on this channel)"
    print(f"  {pkg}{note}")
INNER
    return
  fi

  say "adding to $p (from $channel)"
  local pkg
  for pkg in "$@"; do
    fetch_component "$pkg" "$triple" "$mf" "$p" "$work" no
  done
  say "now: $(mb "$p") MB"
}

# ---- looking at it ---------------------------------------------------------

# Where the toolchain is, whichever way it was installed.
prefix() {
  local d
  for d in "$ROOT"/rust-*; do
    [ -x "$d/bin/rustc" ] && { echo "$d"; return; }
  done
  local tc; tc="$(echo "$ROOT"/rustup/toolchains/*/)"
  [ -x "$tc/bin/rustc" ] && { echo "${tc%/}"; return; }
  die "nothing installed -- run '$0 install'"
}

cmd_size() {
  local p; p="$(prefix)"
  say "total: $(mb "$ROOT") MB"
  echo
  say "irreducible without building rustc from source"
  du -sh "$p/lib/libLLVM.dylib" "$p"/lib/librustc_driver-*.dylib 2>/dev/null \
    | sed 's|/.*/|  |'
  du -sh "$p/lib/rustlib/"*/lib 2>/dev/null | sed 's|/.*rustlib/|  std for |'
  echo
  say "the rest"
  du -sh "$p/bin" 2>/dev/null | sed 's|/.*/|  |'
}

cmd_env() {
  local p; p="$(prefix)"
  if [ -d "$ROOT/rustup" ]; then
    echo "export RUSTUP_HOME=\"$ROOT/rustup\""
    echo "export CARGO_HOME=\"$ROOT/cargo\""
    echo "export PATH=\"$ROOT/cargo/bin:\$PATH\""
  else
    # No rustup, so no proxy shims: the binaries are on PATH directly, and
    # cargo finds rustc there. CARGO_HOME is only where the registry cache and
    # any `cargo install` binaries go.
    echo "export CARGO_HOME=\"$ROOT/cargo-home\""
    echo "export PATH=\"$p/bin:\$PATH\""
  fi
}

case "${1:-}" in
  install)
    shift
    if [ "${1:-}" = "--rustup" ]; then shift; [ $# -eq 0 ] || ROOT="$1"; cmd_install_rustup
    else [ $# -eq 0 ] || ROOT="$1"; cmd_install_direct; fi ;;
  component) shift; cmd_component "$@" ;;
  trim) cmd_trim ;;
  size) cmd_size ;;
  env)  cmd_env ;;
  *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
