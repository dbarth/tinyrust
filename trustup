#!/usr/bin/env bash
#
# trustup -- a thin rustup wrapper for the tinyrust toolchain
#
#   trustup install [DIR]     fetch the toolchain directly (default ~/.rustup)
#   trustup list              what is installed, and what else is on offer
#   trustup size              where the bytes are
#   trustup version           this, and the toolchain it manages
#   trustup go full           the full official toolchain, docs and all
#   trustup go tiny           back to tinyrust, no rustup in the path
#   trustup trim              remove what `go full` installed
#
# Handles only what rustup cannot do for a linked toolchain. Specifically:
#
#   component add N | list
#   target add T    | list
#   update                    tinyrust is replaced whole, not updated
#
# Anything else goes to rustup: show, which, toolchain, default, doc, run.
#
# The toolchain goes to ~/.rustup/toolchains/tinyrust -- rustup's own layout, so
# the two coexist -- and its binaries are linked into ~/.cargo/bin, which is
# added to your shell profile. An existing rustup is never overwritten. Removing
# the toolchain directory and those links removes it.
#
# TRUSTUP_DIST=/path/to/dist installs a toolchain built by ./build-rustc dist
# instead of the official one.
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ~/.rustup is where a Rust toolchain belongs, and where rustup will look if it
# ever turns up: a directory under toolchains/ is exactly what `rustup toolchain
# link` points at. ~/.cargo is not ours to place -- cargo creates it for the
# registry cache whatever we do -- but ~/.cargo/bin is the conventional place
# for the binaries, so that is where they are linked.
ROOT="${TRUSTUP_ROOT:-$HOME/.rustup}"
CARGO_BIN="${TRUSTUP_CARGO_BIN:-$HOME/.cargo/bin}"

# A local dist is always the "local" channel -- pointing TRUSTUP_DIST at a
# directory is the whole switch, there is no second variable to set.
CHANNEL="${TRUSTUP_CHANNEL:-tinyrust}"
# Point TRUSTUP_DIST at a directory of tarballs written by `build-rustc dist`
# (a file:// URL works -- curl handles it) to install a locally built toolchain
# instead of the official one. Same manifest format, same fetch path.
# The tiny packages, unless told otherwise. Falls back to the official dist if
# no release is reachable -- see resolve_dist.
# A tag name, or `latest`. GitHub spells the two cases differently:
# releases/download/<tag>/<asset> for a tag, releases/latest/download/<asset>
# for whatever is current. Getting this backwards 404s.
TINYRUST_RELEASE="${TINYRUST_RELEASE:-latest}"
OFFICIAL="https://static.rust-lang.org/dist"
case "$TINYRUST_RELEASE" in
  latest) RELEASE_PATH="releases/latest/download" ;;
  *)      RELEASE_PATH="releases/download/$TINYRUST_RELEASE" ;;
esac
DIST="${TRUSTUP_DIST:-https://github.com/dbarth/tinyrust/$RELEASE_PATH}"
case "$DIST" in */|*://*) ;; *) DIST="file://$DIST" ;; esac

# macOS ships bash 3.2, which has no $'\uXXXX'; these are the UTF-8 bytes.
TRUSTUP_VERSION="0.1.0"
TICK=$(printf '\342\234\223')
DOWNLOADED_B=0
# what `rustup` costs by default
OFFICIAL_DL=111
OFFICIAL_SIZE=1400
saved() { local d=$(( $1 - $2 )); if [ "$d" -gt 0 ]; then printf '(%s MB saved)' "$d"; fi; }
total() { printf '\033[1m%s %s MB\033[0m %s\n' "$1" "$2" "$3"; }
say()  { printf '\033[1m%s\033[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
die()  { printf 'trustup: %s\n' "$*" >&2; exit 1; }
mb()   { du -sm "$@" 2>/dev/null | awk '{s+=$1} END {print s+0}'; }

# The host triple, from the machine rather than from a guess. This is the whole
# point: rustup ships one rustc that can emit for 330 targets, and exactly one
# of them is ever used here.
host_triple() {
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64)  echo aarch64-apple-darwin ;;
    Darwin/x86_64) echo x86_64-apple-darwin ;;
    Linux/aarch64) echo aarch64-unknown-linux-gnu ;;
    Linux/x86_64)  echo x86_64-unknown-linux-gnu ;;
    *) die "unknown host $(uname -s)/$(uname -m)" ;;
  esac
}

# Files a build never opens, excluded during extraction so they are never
# written at all. Each was measured; `trustup size` prints what is left.
#
# rustdoc and share/doc go because this installs a compiler, not a
# documentation system. The sanitizer runtimes go because they are linked only
# by -Zsanitizer, which is nightly-only. wasm-component-ld goes because it is
# reachable only from a wasm target that is not installed.
#
# NOT excluded, and worth saying why: rust-lld is the default linker for some
# targets and the fallback for others, and libcore's 61 MB .rmeta is the MIR
# every generic instantiation is built from -- drop it and the first `Vec<T>`
# anyone writes fails to compile.
SKIP=(
  --exclude '*/bin/rustdoc'
  --exclude '*/share/doc'
  --exclude '*/librustc-*_rt.*'
  --exclude '*/bin/wasm-component-ld'
)

# ---- direct: three tarballs, no rustup ------------------------------------

# One field out of the channel manifest. The file is a TOML index of every
# component for every target; the entries are regular enough that a parser
# would be ceremony.
manifest_field() {
  local pkg="$1" triple="$2" field="$3" mf="$4"
  python3 - "$pkg" "$triple" "$field" "$mf" "$0" <<'PY'
import re, sys
pkg, triple, field, mf, me = sys.argv[1:6]
s = open(mf, encoding="utf-8").read()
head = f"[pkg.{pkg}.target.{triple}]"
i = s.find(head)
if i < 0:
    sys.exit(f"trustup: {pkg} is not published for {triple}")
body = s[i + len(head):]
body = body[:body.find("\n[")]
m = re.search(rf'{field} = "([^"]+)"', body)
if not m:
    # The entry exists but carries no artefact: the component is real, just not
    # built for this target on this channel. cranelift, for one, is nightly.
    if "available = false" in body:
        sys.exit(f"trustup: {pkg} is not available for {triple} on this channel\n"
                 f"  some components are nightly-only -- try:\n"
                 f"  TRUSTUP_CHANNEL=nightly {me} install && {me} component add {pkg}")
    sys.exit(f"trustup: no {field} for {pkg}/{triple}")
print(m.group(1))
PY
}

# Tens of megabytes over a link of unknown speed: silence reads as a hang. A
# spinner is enough -- these are a handful of files whose sizes are printed the
# moment each lands, and a percentage that runs for four seconds is noise.
SPIN='|/-\'

# Column 0 is the mark, then the item, then the size in a fixed column so every
# line agrees -- manifest included. Called with no size for a failure, which
# prints the mark and the name alone.
mark() {
  local m="$1" label="$2" sz="${3:-}" extra="${4:-}"
  if [ -n "$sz" ]; then printf '\r%s %-22s %5s MB%s\n' "$m" "$label" "$sz" "${extra:+  $extra}"
  else                  printf '\r%s %s\n' "$m" "$label"
  fi
}

# macOS validates a freshly written Mach-O the first time it is executed --
# rustc plus the 110 MB librustc_driver it loads -- and caches the verdict.
# That is ~3 s, and it gets paid once whatever happens. Pay it here, where a
# wait is expected and a line says what is going on, rather than on the first
# bare `trustup` or the first `cargo build`, where it reads as a hang.
warm_rustc_cargo() {
  note "checking binaries"
  "$dest/bin/rustc" --version >/dev/null 2>&1 || true
  "$dest/bin/cargo" --version >/dev/null 2>&1 || true
}

# rustc is 30 MB and the rest are not, so a spinner alone leaves you guessing
# for a minute. The counter climbs in the same column the final size lands in,
# so the line resolves in place instead of jumping.
download() {                              # download <label> <url> <out>
  local label="$1" url="$2" out="$3" pid rc=0 i=0 now
  if [ ! -t 1 ]; then
    curl -sSfL -o "$out" "$url" || { mark x "$label"; return 1; }
    return 0
  fi
  curl -sSfL -o "$out" "$url" & pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    now=$(( $(stat -f%z "$out" 2>/dev/null || echo 0) / 1048576 ))
    printf '\r%s %-22s %5s MB' "${SPIN:$((i % 4)):1}" "$label" "$now"
    i=$((i + 1)); sleep 0.2
  done
  wait "$pid" || rc=$?
  [ "$rc" = 0 ] || mark x "$label"
  return $rc
}

fetch_component() {
  local pkg="$1" triple="$2" mf="$3" dest="$4" work="$5" prune="${6:-yes}"
  local url hash tarball got

  url="$(manifest_field "$pkg" "$triple" xz_url "$mf")"
  hash="$(manifest_field "$pkg" "$triple" xz_hash "$mf")"
  tarball="$work/$(basename "$url")"

  download "$pkg" "$url" "$tarball" || die "could not download $url"
  # There are no per-package dates -- the manifest carries one date for the
  # whole channel. A version there is, in the file name, and it is the thing
  # worth seeing when a component comes from a different dist.
  local ver; ver="$(basename "$url")"; ver="${ver%.tar.xz}"
  ver="${ver#"$pkg"-}"; ver="${ver%-"$triple"}"
  local dlb; dlb="$(stat -f%z "$tarball")"
  DOWNLOADED_B=$(( DOWNLOADED_B + dlb ))
  local dl=$(( dlb / 1048576 ))

  # Verified here rather than trusted: this is the one thing rustup does that
  # a plain download does not.
  got="$(shasum -a 256 "$tarball" | cut -d' ' -f1)"
  [ "$got" = "$hash" ] || die "$pkg checksum mismatch
     expected $hash
     got      $got"

  # strip 2: the archive is <pkg>-<version>-<triple>/<component>/<files>, and
  # only <files> belongs under the prefix.
  # Pruned only for the three that come by default. A component somebody asked
  # for by name is extracted whole -- asking for rust-docs and getting nothing
  # because share/doc is on the skip list would be a poor joke.
  if [ "$prune" = yes ]; then
    tar -xJf "$tarball" -C "$dest" --strip-components=2 "${SKIP[@]}"
  else
    tar -xJf "$tarball" -C "$dest" --strip-components=2
  fi
  rm -f "$tarball"

  # There is no package database here, so keep the one fact that cannot be
  # recovered from the files afterwards: which components were asked for.
  grep -qxF "$pkg" "$dest/.trustup-components" 2>/dev/null \
    || printf '%s\n' "$pkg" >> "$dest/.trustup-components"

  mark "$TICK" "$pkg" "$dl" "$ver${FROM:+  $FROM}"
}

cmd_install_direct() {
  local triple; triple="$(host_triple)"
  # NOT named after the triple. rustc finds its sysroot by walking up from its
  # own path, and treats `<sysroot>/lib/rustlib/<triple>/bin/rustc` as a
  # special case -- a prefix called `aarch64-apple-darwin` trips that rule and
  # the sysroot lands four directories too high.
  # One name, whatever the channel -- the channel is recorded in
  # .trustup-channel, and rust-<channel> was never a rustup convention anyway
  # (rustup names toolchains <channel>-<triple>, under ~/.rustup/toolchains).
  # rustup's own layout, so the two can coexist and `rustup default tinyrust`
  # works once a rustup exists.
  local dest="$ROOT/toolchains/tinyrust"
  say "downloading $CHANNEL for $triple"
  mkdir -p "$dest"

  local work; work="$(mktemp -d)"
  trap 'rm -rf "$work"' RETURN

  local mf="$work/channel.toml"
  download manifest "$DIST/channel-rust-$CHANNEL.toml" "$mf" \
    || die "could not fetch the $CHANNEL manifest"
  mark "$TICK" manifest "$(mb "$mf")" \
    "$(sed -n 's/^date = "\(.*\)"/\1/p' "$mf" | head -1)"

  # Three components, and there is no fourth worth having: rustc carries the
  # compiler and its LLVM, rust-std the library for this target, cargo the
  # build tool. rust-docs is a package of its own, which is why 893 MB of HTML
  # is never even requested.
  local pkg
  for pkg in rustc rust-std cargo; do
    # Official tarballs carry things a build never opens, so they are pruned
    # during extraction. A tinyrust dist -- the published release as much as a
    # local one -- has already had everything unwanted left out; pruning it
    # again deletes rustdoc, which this toolchain ships on purpose for
    # doctests. The test is which dist this is, not whether TRUSTUP_DIST
    # happens to be set: that variable is for local testing, and gating on it
    # meant every `curl | sh` install lost rustdoc.
    local prune=no
    case "$DIST" in "$OFFICIAL"*) prune=yes ;; esac
    fetch_component "$pkg" "$triple" "$mf" "$dest" "$work" "$prune"
  done

  # rust-objcopy lives in lib/rustlib/<triple>/bin and has an rpath of
  # @loader_path/../lib, but libLLVM.dylib ships in the prefix's own lib. cargo
  # calls it to strip release binaries, so without this it warns on every build.
  local tb
  for tb in "$dest"/lib/rustlib/*/bin; do
    [ -d "$tb" ] || continue
    mkdir -p "$tb/../lib"
    ln -sf ../../../libLLVM.dylib "$tb/../lib/libLLVM.dylib"
  done

  printf '%s\n' "$CHANNEL" > "$dest/.trustup-channel"
  local dl=$(( DOWNLOADED_B / 1048576 )) sz; sz="$(mb "$dest")"
  printf '  %-22s %5s MB  total\n' downloaded "$dl"

  total "tinyrust installed" "$sz" "$(saved "$OFFICIAL_SIZE" "$sz")"
  note "placed into $dest"
  link_into_path "$dest"
  warm_rustc_cargo

  say "start with:"
  # whether this shell needs the env sourced
  case ":$PATH:" in
    *":$CARGO_BIN:"*) ;;
    *) note ". \"\$HOME/.cargo/env\"" ;;
  esac
  note "cargo new hello && cd hello && cargo run"
  echo
}

# ---- adding a component ----------------------------------------------------

# `rustup component add` and `component list`, for an install that has no
# rustup -- and a straight pass-through to the real one when there is.
#
# A component must match the toolchain it joins -- the manifest publishes one
# version per channel per day -- so this reads the channel recorded at install
# time rather than whatever TRUSTUP_CHANNEL happens to say now.
#
# `list` reads what the manifest offers for this target, which is what
# `rustup component list` reports from the same data.
# Everything trustup does not need to intercept goes to the real rustup, so it
# is a drop-in rather than a subset. Only the verbs where tinyrust differs are
# handled here: install (fetch tiny, prune, one directory), component (resolve
# against the manifest without a package database), trim, size and env.
#
# A --rustup install has a real rustup under $ROOT/rustup. A direct install does
# not, and cannot invent one, so the passthrough says so plainly instead of
# failing with something obscure.
# The upstream-ok list is a claim, so check it rather than trust it: a
# component that turns out to link librustc_driver was compiled against another
# compiler and will die at exec with a dyld error. Caught here instead.
upstream_is_independent() {
  local pkg="$1" before="$2" after="$3" f bad=""
  # Only what this component just unpacked. The toolchain's own rustc and
  # rustdoc link librustc_driver by design and are not the question.
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$(file -b "$f" 2>/dev/null)" in *Mach-O*) ;; *) continue ;; esac
    otool -L "$f" 2>/dev/null | grep -q 'librustc_driver' && bad="$bad $(basename "$f")"
  done < <(comm -13 "$before" "$after")
  [ -z "$bad" ] && return 0
  die "$pkg links librustc_driver ($bad ) and was built by a different rustc.
       It is wrongly listed upstream-ok in this dist's manifest. Remove it, and
       reinstall the toolchain to drop what was just unpacked."
}

# What this is, and what it is managing. Both, because the version of trustup
# says nothing about the toolchain it installed.
# A shimmed cargo needs RUSTUP_HOME, and rustup lives nested where it will not
# look. In a shell that never sourced ~/.cargo/env, `cargo` then dies with a
# rustup error that names neither cause nor cure.
check_shims() {
  case "$(readlink "$CARGO_BIN/cargo" 2>/dev/null)" in
    "$ROOT"/cargo/bin/*) ;;
    *) return 0 ;;
  esac
  [ -z "${RUSTUP_HOME:-}" ] || return 0
  note "cargo here is a rustup shim and RUSTUP_HOME is unset -- it will not run."
  note "  . \"\$HOME/.cargo/env\"      for this shell"
  note "  trustup go tiny            to stop going through rustup"
}

cmd_version() {
  local q; q="$(prefix 2>/dev/null)" || q=""
  echo "trustup $TRUSTUP_VERSION"
  if [ -n "$q" ] && [ -x "$q/bin/rustc" ]; then
    echo "$("$q/bin/rustc" --version 2>/dev/null) at $q"
  else
    echo "no toolchain installed"
  fi
  check_shims
}

# rustup reports "no updatable toolchains installed" for a linked toolchain,
# which is true and useless. Named toolchains are its business, so those pass
# through; a bare `update` is about tinyrust, and tinyrust is replaced whole.
cmd_update() {
  if [ $# -gt 0 ]; then passthrough update "$@"; fi
  say "tinyrust has no in-place update"
  note "reinstall to move to the current release:"
  note "  trustup install"
}

# A target is a component to rustup, so it refuses these on a linked toolchain
# exactly as it refuses `component add`. Ours are plain rust-std packages.
cmd_target() {
  local verb="${1:-list}"; shift || true
  ours_is_active || passthrough target "$verb" "$@"
  case "$verb" in
    add|list) ;;
    *) passthrough target "$verb" "$@" ;;
  esac
  local q; q="$(prefix)"
  local work; work="$(mktemp -d)"
  trap 'rm -rf "$work"' RETURN
  local channel; channel="$(cat "$q/.trustup-channel" 2>/dev/null || echo "$CHANNEL")"
  local mf="$work/channel.toml"
  curl -sSfL -o "$mf" "$DIST/channel-rust-$channel.toml" \
    || die "could not fetch the $channel manifest"

  if [ "$verb" = list ]; then
    say "targets on $channel"
    local tr
    for tr in $(grep -o '^\[pkg\.rust-std\.target\.[^]]*\]' "$mf" \
                | sed 's/^\[pkg\.rust-std\.target\.//; s/\]$//'); do
      if [ -d "$q/lib/rustlib/$tr/lib" ]; then note "$tr  (installed)"; else note "$tr"; fi
    done
    return
  fi

  [ $# -gt 0 ] || die "target add needs a triple -- 'trustup target list' shows them"
  local tr
  for tr in "$@"; do
    grep -qF "[pkg.rust-std.target.$tr]" "$mf" \
      || die "no rust-std for $tr in this dist -- 'trustup target list' shows what there is"
    FROM="$channel" fetch_component rust-std "$tr" "$mf" "$q" "$work" no
  done
  say "now: $(mb "$q") MB"
}

# ---- handing over to rustup ------------------------------------------------

# Until now ~/.cargo/bin pointed straight at tinyrust's binaries, which bypass
# rustup entirely -- `rustup default` would decide nothing. Repoint them at
# rustup's shims so it does. `rustup` and `trustup` are left alone: switching
# back to tinyrust means needing the interception again.
hand_over() {
  local q f base; q="$(prefix)"
  for f in "$ROOT"/cargo/bin/*; do
    base="$(basename "$f")"
    case "$base" in rustup|trustup) continue ;; esac
    # Only names that are already ours -- pointing at tinyrust, or at these
    # same shims from an earlier handover. A pre-existing rustup's shims are
    # somebody else's toolchain manager, and install promised to leave them be.
    case "$(readlink "$CARGO_BIN/$base" 2>/dev/null)" in
      "$q"/bin/*|"$ROOT"/cargo/bin/*) ln -sf "$f" "$CARGO_BIN/$base" ;;
      "") [ -e "$CARGO_BIN/$base" ] || ln -sf "$f" "$CARGO_BIN/$base" ;;
      *) note "left the existing $base in $CARGO_BIN alone" ;;
    esac
  done
  note "pointed $CARGO_BIN at rustup's shims"
}

# Which toolchain drives ~/.cargo/bin. `go full` hands it to rustup, `go tiny`
# takes it back. Nothing here installs or removes anything by itself except
# the toolchain `full` needs; `trim` is what removes.
cmd_go() {
  case "${1:-}" in
    tiny) go_tiny ;;
    full) shift; go_full "$@" ;;
    *)    die "go takes 'tiny' or 'full'" ;;
  esac
}

# The inverse of hand_over. After `toolchain add`, ~/.cargo/bin points at
# rustup's shims for good: a reinstall will not take them back, because
# claimed() cannot tell a shim we made from a foreign rustup's. This says
# plainly that tinyrust drives again. rustup and the full toolchain stay
# installed -- `trustup toolchain add` hands the wheel back.
go_tiny() {
  local q f base; q="$(prefix)"
  # Agree with rustup rather than contradict it: with direct links, `rustup
  # default` stops deciding anything, so leave it pointing where we point.
  if [ -x "$ROOT/cargo/bin/rustup" ]; then
    RUSTUP_HOME="$ROOT/rustup" "$ROOT/cargo/bin/rustup" default tinyrust >/dev/null 2>&1 || true
  fi
  for f in "$q"/bin/*; do
    [ -x "$f" ] || continue
    base="$(basename "$f")"
    case "$base" in trustup) continue ;; esac
    ln -sf "$f" "$CARGO_BIN/$base"
  done
  say "tinyrust drives $CARGO_BIN again"
  note "rustup and anything it installed are untouched"
  note "trustup go full        hands it back"
}

# The full official toolchain, docs and all. rustup's default profile is what
# the 1.4 GB in the README measures -- rustc, cargo, std, rust-docs, rustfmt,
# clippy -- so this is the thing tinyrust is small against, one command away.
go_full() {
  local name="${1:-stable}"
  ensure_rustup go
  export RUSTUP_HOME="$ROOT/rustup" CARGO_HOME="$ROOT/cargo"
  local before; before="$(mb "$ROOT")"
  say "installing $name, full profile -- rustc, cargo, std, docs, rustfmt, clippy"
  "$CARGO_HOME/bin/rustup" toolchain install "$name" --profile default \
    || die "rustup could not install $name"
  "$CARGO_HOME/bin/rustup" default "$name" >/dev/null \
    || die "rustup could not make $name the default"

  hand_over
  # At install time there was no rustup, so the env file has no RUSTUP_HOME.
  write_cargo_env
  total "$name:" "$(( $(mb "$ROOT") - before ))" "(now $(mb "$ROOT") MB total)"
  note "trustup go tiny     back to the small one"
  note "trustup trim        remove it again"
  note "open a new shell, or: . \"\$HOME/.cargo/env\""
}

# Undo `go full`. Only what rustup installed goes -- tinyrust and rustup itself
# stay, so `go full` can put it back without refetching rustup.
cmd_trim() {
  [ -x "$ROOT/cargo/bin/rustup" ] || die "nothing to trim -- no rustup installed here"
  export RUSTUP_HOME="$ROOT/rustup" CARGO_HOME="$ROOT/cargo"
  local list tc
  list="$("$CARGO_HOME/bin/rustup" toolchain list 2>/dev/null | awk '$1 != "tinyrust" {print $1}')"
  [ -n "$list" ] || die "nothing to trim -- tinyrust is the only toolchain"

  say "removing:"
  for tc in $list; do note "$tc"; done
  local ans=""
  if [ -t 0 ]; then
    printf '  proceed? [y/N] '
    read -r ans || ans=""
  fi
  case "$ans" in y|Y|yes|YES) ;; *) die "nothing removed" ;; esac

  local before; before="$(mb "$ROOT")"
  # Never delete what is currently running.
  go_tiny >/dev/null
  for tc in $list; do
    "$CARGO_HOME/bin/rustup" toolchain uninstall "$tc" >/dev/null 2>&1 || true
  done
  total "freed:" "$(( before - $(mb "$ROOT") ))" "(now $(mb "$ROOT") MB total)"
  note "tinyrust drives again"
}

cmd_help() {
  sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
}

# Interception is right only while tinyrust is the toolchain rustup would run.
# Once a real one is the default, components are rustup's business again --
# quietly adding them to tinyrust instead would be a wrong answer, not a
# smaller one.
ours_is_active() {
  [ -x "$ROOT/cargo/bin/rustup" ] || return 0          # no rustup: all ours
  local d
  d="$(RUSTUP_HOME="$ROOT/rustup" "$ROOT/cargo/bin/rustup" default 2>/dev/null)" || return 0
  case "$d" in tinyrust*|"") return 0 ;; *) return 1 ;; esac
}

passthrough() {
  local verb="$1"; shift
  ensure_rustup "$verb"
  export RUSTUP_HOME="$ROOT/rustup" CARGO_HOME="$ROOT/cargo"
  exec "$ROOT/cargo/bin/rustup" "$verb" "$@"
}

# rustup is fetched the first time a verb needs it, not asked about. It is
# installed with no toolchain of its own -- the one already here is linked in
# as "tinyrust" and made default, so `rustup show`, `which`, `target add` and
# the rest operate on this toolchain rather than downloading a second one.
ensure_rustup() {                         # ensure_rustup <verb, for the message>
  export RUSTUP_HOME="$ROOT/rustup" CARGO_HOME="$ROOT/cargo"
  if [ ! -x "$CARGO_HOME/bin/rustup" ]; then
    say "first-time use, fetching rustup, for '$1'"
    mkdir -p "$ROOT"
    local init="$ROOT/rustup-init.sh"
    # Plain curl: this is a 20 KB shell script, and `download` leaves its
    # spinner line open for a caller-printed mark that does not belong here.
    [ -f "$init" ] || curl -sSfL "https://sh.rustup.rs" -o "$init" \
      || die "could not download rustup-init"
    # rustup-init's own progress is left visible. Silencing it made every
    # passed-through command look like a hang: one line, then nothing for as
    # long as the download took.
    sh "$init" -y --no-modify-path --profile minimal \
       --default-toolchain none 2>&1 | sed 's/^/  /' \
      || die "rustup-init failed"
  fi
  local p; p="$(prefix)"
  if [ -d "$p" ] && ! "$CARGO_HOME/bin/rustup" toolchain list 2>/dev/null | grep -q '^tinyrust'; then
    "$CARGO_HOME/bin/rustup" toolchain link tinyrust "$p" >/dev/null 2>&1 || true
    "$CARGO_HOME/bin/rustup" default tinyrust >/dev/null 2>&1 || true
  fi
}

# rustup drops its binaries in ~/.cargo/bin and appends that directory to the
# shell profile, so `cargo` works in a new terminal. Same here, or the toolchain
# is invisible until you remember to eval something. Symlinks, not copies: an
# upgrade replaces the toolchain and the links keep pointing at it.
# True when a path exists and is not ours: either a real file, or a symlink
# pointing somewhere other than this toolchain or this trustup.
# PATH, plus the home rustup's shims cannot infer because rustup lives nested
# under $ROOT. Without the second line a shimmed `cargo` says "no default".
write_cargo_env() {
  mkdir -p "$HOME/.cargo"
  printf '#!/bin/sh\ncase ":$PATH:" in *":%s:"*) ;; *) PATH="%s:$PATH"; export PATH ;; esac\n' \
    "$CARGO_BIN" "$CARGO_BIN" > "$HOME/.cargo/env"
  if [ -d "$ROOT/rustup" ]; then
    printf 'RUSTUP_HOME="%s"; export RUSTUP_HOME\n' "$ROOT/rustup" >> "$HOME/.cargo/env"
  fi
}

claimed() {
  local target="$1" p="$2" dest
  [ -e "$target" ] || [ -L "$target" ] || return 1
  [ -L "$target" ] || return 0
  dest="$(readlink "$target")"
  case "$dest" in "$p"/*) return 1 ;; *) return 0 ;; esac
}

link_into_path() {
  local p="$1" f base
  mkdir -p "$CARGO_BIN" "$p/bin"

  # trustup installs itself into the toolchain it manages. The links below then
  # point at that copy, so they survive the checkout being moved or deleted and
  # do not depend on where the install was run from -- local or fetched.
  # $0 may be the ~/.cargo/bin/rustup symlink pointing at the copy we are about
  # to write, so compare inodes rather than paths.
  local self; self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  if ! [ "$self" -ef "$p/bin/trustup" ]; then
    install -m 755 "$self" "$p/bin/trustup"
  fi
  # rustup owns cargo/rustc/rustdoc shims in this same directory. Replacing
  # them would silently repoint somebody's existing toolchain at ours, so a
  # name that is already taken by something that is not one of our symlinks is
  # left alone.
  for f in "$p"/bin/*; do
    [ -x "$f" ] || continue
    base="$(basename "$f")"
    if claimed "$CARGO_BIN/$base" "$p"; then
      note "left the existing $base in $CARGO_BIN alone"
    else
      ln -sf "$f" "$CARGO_BIN/$base"
    fi
  done


  # `rustup` as an alias for trustup, so muscle memory and any script that
  # calls rustup keep working. Never over a real rustup: if one is already
  # there, that is somebody's toolchain manager and not ours to replace.
  if claimed "$CARGO_BIN/rustup" "$p"; then
    note "left the existing rustup in $CARGO_BIN alone -- use 'trustup'"
  else
    ln -sf "$p/bin/trustup" "$CARGO_BIN/rustup"
  fi
  note "linked into $CARGO_BIN"

  local line=". \"\$HOME/.cargo/env\""
  write_cargo_env
  local rc
  for rc in "$HOME/.zshenv" "$HOME/.bashrc" "$HOME/.profile"; do
    [ -e "$rc" ] || continue
    grep -qF '.cargo/env' "$rc" 2>/dev/null && continue
    printf '\n%s\n' "$line" >> "$rc"
    note "added $CARGO_BIN to $(basename "$rc")"
  done
}

cmd_component() {
  local verb="${1:-list}"; shift || true
  ours_is_active || passthrough component "$verb" "$@"
  case "$verb" in
    add|list) ;;
    *) die "component takes 'add' or 'list', not '$verb'" ;;
  esac
  [ "$verb" = add ] && [ $# -eq 0 ] && die "component add needs a name -- '$0 component list' shows them"

  local p; p="$(prefix)"

  local triple; triple="$(host_triple)"
  local channel; channel="$(cat "$p/.trustup-channel" 2>/dev/null || echo "$CHANNEL")"

  local work; work="$(mktemp -d)"
  trap 'rm -rf "$work"' RETURN
  local mf="$work/channel.toml"
  curl -sSfL -o "$mf" "$DIST/channel-rust-$channel.toml" \
    || die "could not fetch the $channel manifest"

  if [ "$verb" = list ]; then
    say "components for $triple on $channel"
    python3 - "$triple" "$mf" "$p/.trustup-components" <<'INNER'
import os, re, sys
triple, mf, have_file = sys.argv[1:4]
have = set()
if os.path.exists(have_file):
    have = {l.strip() for l in open(have_file) if l.strip()}
s = open(mf, encoding="utf-8").read()
pat = r'\[pkg\.([^.\]]+)\.target\.' + re.escape(triple) + r'\](.*?)(?=\n\[)'
for pkg, body in re.findall(pat, s, re.S):
    if pkg in have:   note = "  (installed)"
    elif "available = true" in body: note = ""
    else: note = "  (not on this channel)"
    print(f"  {pkg}{note}")
INNER
    return
  fi

  # Three outcomes, never a silent mix. A component this dist provides comes
  # from this dist. One the dist declares upstream-ok is fetched from the
  # official channel, because it only runs rustc or carries no code at all.
  # Anything else links librustc_driver or loads .rmeta, and the official build
  # of it was compiled by a different rustc -- E0514, not a subtle bug.
  local ok; ok=" $(sed -n 's/^upstream-ok = \[\(.*\)\]/\1/p' "$mf" | tr -d '",' ) "
  local omf="" pkg
  say "adding to $p"
  for pkg in "$@"; do
    # rustup takes the short name and resolves it; the manifest publishes these
    # as <name>-preview. Do the same, rather than making people know which of
    # clippy, rustfmt and rust-analyzer carry the suffix and which do not.
    if ! grep -qF "[pkg.$pkg.target." "$mf" && grep -qF "[pkg.$pkg-preview.target." "$mf"; then
      pkg="$pkg-preview"
    fi
    # Not everything with a name is a component. rustdoc ships inside rustc,
    # and rustc and cargo are the toolchain -- refusing those as "unsafe to
    # take from upstream" is true but beside the point when they are already
    # here. rustup answers the same request with "does not contain component".
    if [ -x "$p/bin/$pkg" ]; then
      note "$pkg is already here -- it ships inside the toolchain, not as a component"
      continue
    fi
    if grep -qF "[pkg.$pkg.target.$triple]" "$mf"; then
      FROM="$channel" fetch_component "$pkg" "$triple" "$mf" "$p" "$work" no
    elif [ "$DIST" != "https://static.rust-lang.org/dist" ] && \
         case "$ok" in *" $pkg "*) true ;; *) false ;; esac; then
      if [ -z "$omf" ]; then
        omf="$work/official.toml"
        curl -sSfL -o "$omf" "https://static.rust-lang.org/dist/channel-rust-stable.toml" \
          || die "could not fetch the official manifest"
      fi
      # Target-independent components (rust-src, the docs) are published under
      # the literal target "*", not a triple.
      # Target-independent components are keyed by the literal, quoted "*".
      local key="$triple"
      grep -qF "[pkg.$pkg.target.$triple]" "$omf" || key='"*"'
      local b="$work/before.$pkg" a="$work/after.$pkg"
      find "$p" -type f 2>/dev/null | sort > "$b"
      DIST=https://static.rust-lang.org/dist FROM="official dist" \
        fetch_component "$pkg" "$key" "$omf" "$p" "$work" no
      find "$p" -type f 2>/dev/null | sort > "$a"
      upstream_is_independent "$pkg" "$b" "$a"
    else
      die "$pkg is not in this dist, and is not safe to take from the official
       one: it links librustc_driver or loads crate metadata, and the official
       build of it was compiled by a different rustc. Build it with build-rustc."
    fi
  done
  # A component that ships binaries is useless until they are on PATH, and
  # install-time linking happened before this component existed.
  link_into_path "$p"
  say "now: $(mb "$p") MB"
}

# ---- looking at it ---------------------------------------------------------

# Where the toolchain is, whichever way it was installed.
prefix() {
  local d
  # rust-* is the old layout, still recognised so an existing install keeps
  # working after the rename.
  for d in "$ROOT"/toolchains/tinyrust "$ROOT"/tinyrust "$ROOT"/rust-*; do
    [ -x "$d/bin/rustc" ] && { echo "$d"; return; }
  done
  local tc; tc="$(echo "$ROOT"/rustup/toolchains/*/)"
  [ -x "$tc/bin/rustc" ] && { echo "${tc%/}"; return; }
  die "nothing installed -- run '$0 install'"
}

cmd_size() {
  local p; p="$(prefix)"
  say "total: $(mb "$ROOT") MB"
  echo
  say "irreducible without building rustc from source"
  du -sh "$p/lib/libLLVM.dylib" "$p"/lib/librustc_driver-*.dylib 2>/dev/null \
    | sed 's|/.*/|  |'
  du -sh "$p/lib/rustlib/"*/lib 2>/dev/null | sed 's|/.*rustlib/|  std for |'
  echo
  say "the rest"
  du -sh "$p/bin" 2>/dev/null | sed 's|/.*/|  |'
}


# Invoked as `rustup` this is a stand-in and stays out of the way; invoked as
# `trustup` it is itself. Either way the rule is the same: handle only what
# rustup cannot do for a linked toolchain, and hand it everything else.
case "${1:-}" in
  # ours
  install)   shift; [ $# -eq 0 ] || ROOT="$1"; cmd_install_direct ;;
  list)      cmd_component list ;;
  size)      cmd_size ;;
  go)        shift; cmd_go "$@" ;;
  trim)      cmd_trim ;;
  version)   cmd_version ;;

  # rustup refuses these on a linked toolchain, or answers with nothing
  component) shift; cmd_component "$@" ;;
  target)    shift; cmd_target "$@" ;;
  update)    shift; cmd_update "$@" ;;

  # A bare invocation gets our summary, whatever we are called: printing
  # rustup's help would fetch 10 MB of rustup to do it, and ours says where
  # everything else goes. `rustup help` is an explicit request for the real
  # thing, so it gets the real thing.
  ""|-h|--help|help)
    if [ -n "${1:-}" ] && [ "$(basename "$0")" = rustup ]
    then passthrough "$@"
    else cmd_help
    fi ;;

  *) passthrough "$@" ;;
esac
