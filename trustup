#!/usr/bin/env bash
#
# trustup -- install the smallest Rust toolchain that still builds for THIS
# machine, and nothing else.
#
#   trustup install [DIR]     install into DIR (default ./toolchain)
#   trustup trim              remove what a build never reads
#   trustup size              where the bytes are
#   trustup env               shell lines to use it
#
# Everything lives under one directory. Nothing touches ~/.rustup, ~/.cargo or
# PATH -- `trustup env` prints what to source, and removing the directory
# removes the toolchain.
#
# See README.md for what cannot be made smaller and why.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${TRUSTUP_ROOT:-$HERE/toolchain}"
export RUSTUP_HOME="$ROOT/rustup" CARGO_HOME="$ROOT/cargo"
RUSTUP="$CARGO_HOME/bin/rustup"

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
mb()   { du -sm "$@" 2>/dev/null | awk '{s+=$1} END {print s+0}'; }

# The host triple, from the machine rather than from a guess. This is the whole
# point: rustup ships one rustc that can emit for 330 targets, and exactly one
# of them is ever used here.
host_triple() {
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64)  echo aarch64-apple-darwin ;;
    Darwin/x86_64) echo x86_64-apple-darwin ;;
    Linux/aarch64) echo aarch64-unknown-linux-gnu ;;
    Linux/x86_64)  echo x86_64-unknown-linux-gnu ;;
    *) echo "trustup: unknown host $(uname -s)/$(uname -m)" >&2; exit 1 ;;
  esac
}

cmd_install() {
  [ $# -eq 0 ] || ROOT="$1"
  export RUSTUP_HOME="$ROOT/rustup" CARGO_HOME="$ROOT/cargo"
  local triple; triple="$(host_triple)"

  say "installing for $triple into $ROOT"
  mkdir -p "$ROOT"
  local init="$ROOT/rustup-init.sh"
  [ -f "$init" ] || curl -sSf https://sh.rustup.rs -o "$init"

  # --profile minimal is the only knob that matters: it is rustc + cargo +
  # rust-std and nothing else. The default profile adds rust-docs, which is
  # 893 MB of generated HTML -- more than the compiler and the library put
  # together.
  sh "$init" -y --no-modify-path --profile minimal \
     --default-toolchain stable --default-host "$triple" >/dev/null

  note "installed: $(mb "$ROOT") MB"
  say "now run: $0 trim"
}

# Files a build never opens. Each is measured, not guessed -- `trustup size`
# prints them before and after.
#
# rustdoc and share/doc go because this installs a compiler, not a
# documentation system. The sanitizer runtimes go because they are only linked
# by -Zsanitizer, which is nightly-only. wasm-component-ld goes because it is
# reachable only from a wasm target that is not installed.
#
# NOT removed, and worth saying why: rust-lld is the default linker for some
# targets and the fallback for others, and libcore's 61 MB .rmeta is the MIR
# every generic instantiation is built from -- deleting it breaks the first
# `Vec<T>` anyone writes.
cmd_trim() {
  local tc; tc="$(echo "$RUSTUP_HOME"/toolchains/*/)"
  [ -d "$tc" ] || { echo "trustup: nothing installed -- run '$0 install'" >&2; exit 1; }
  local before; before="$(mb "$ROOT")"

  say "trimming $tc"
  local gone=0
  for path in \
      "$tc/bin/rustdoc" \
      "$tc/share/doc" \
      "$tc/lib/rustlib/"*/bin/wasm-component-ld
  do
    [ -e "$path" ] || continue
    note "$(basename "$path") -- $(mb "$path") MB"
    rm -rf "$path"; gone=1
  done
  for san in "$tc"/lib/librustc-*_rt.*.dylib "$tc"/lib/librustc-*_rt.*.a; do
    [ -e "$san" ] || continue
    note "$(basename "$san") -- $(mb "$san") MB"
    rm -f "$san"; gone=1
  done
  [ "$gone" = 1 ] || note "nothing left to trim"

  say "$before MB -> $(mb "$ROOT") MB"
}

cmd_size() {
  local tc; tc="$(echo "$RUSTUP_HOME"/toolchains/*/)"
  [ -d "$tc" ] || { echo "trustup: nothing installed" >&2; exit 1; }
  say "total: $(mb "$ROOT") MB"
  echo
  say "irreducible without building rustc from source"
  du -sh "$tc/lib/libLLVM.dylib" "$tc"/lib/librustc_driver-*.dylib 2>/dev/null \
    | sed 's|/.*/|  |'
  du -sh "$tc/lib/rustlib/"*/lib 2>/dev/null | sed 's|/.*rustlib/|  std for |'
  echo
  say "the rest"
  du -sh "$tc/bin" "$CARGO_HOME" 2>/dev/null | sed 's|/.*/|  |'
}

cmd_env() {
  echo "export RUSTUP_HOME=\"$RUSTUP_HOME\""
  echo "export CARGO_HOME=\"$CARGO_HOME\""
  echo "export PATH=\"$CARGO_HOME/bin:\$PATH\""
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  trim)    cmd_trim ;;
  size)    cmd_size ;;
  env)     cmd_env ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
